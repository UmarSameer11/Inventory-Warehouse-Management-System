@model WarehouseManagementSystemWeb.Application.ViewModels.Product.ProductCreateViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Create Product
            </h3>

            <p class="text-muted mb-0">
                Add a new product and define its pricing and inventory settings.
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Products

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="create-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h5 class="fw-semibold mb-1">
                        Product Information
                    </h5>

                    <span class="text-muted small">
                        Enter product details, category, pricing and stock settings.
                    </span>
                </div>

            </div>

        </div>


        <!-- Form -->
        <div class="card-body p-4">

            <form asp-controller="Product"
                  asp-action="Create"
                  method="post"
                  id="productCreateForm">

                @Html.AntiForgeryToken()


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary"
                     role="alert">
                </div>


                <!-- Basic Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Basic Information
                        </h6>

                        <p class="text-muted small mb-0">
                            Enter the basic identification details of the product.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Product Code -->
                        <div class="col-md-6">

                            <label asp-for="ProductCode"
                                   class="form-label fw-semibold">

                                Product Code
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="ProductCode"
                                   class="form-control"
                                   placeholder="e.g. PROD-001"
                                   autocomplete="off" />

                            <span asp-validation-for="ProductCode"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Product Name -->
                        <div class="col-md-6">

                            <label asp-for="ProductName"
                                   class="form-label fw-semibold">

                                Product Name
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="Enter product name"
                                   autocomplete="off" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Classification Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Classification Information
                        </h6>

                        <p class="text-muted small mb-0">
                            Assign the product to a category and unit of measure.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Product Category -->
                        <div class="col-md-6">

                            <label asp-for="ProductCategoryId"
                                   class="form-label fw-semibold">

                                Product Category
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="ProductCategoryId"
                                    asp-items="Model.ProductCategories"
                                    class="form-select">

                                <option value="">
                                    Select Product Category
                                </option>

                            </select>

                            <span asp-validation-for="ProductCategoryId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Unit Of Measure -->
                        <div class="col-md-6">

                            <label asp-for="UnitOfMeasureId"
                                   class="form-label fw-semibold">

                                Unit of Measure
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="UnitOfMeasureId"
                                    asp-items="Model.UnitOfMeasures"
                                    class="form-select">

                                <option value="">
                                    Select Unit of Measure
                                </option>

                            </select>

                            <span asp-validation-for="UnitOfMeasureId"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Pricing & Inventory -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Pricing & Inventory
                        </h6>

                        <p class="text-muted small mb-0">
                            Define the product price and reorder level.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Unit Price -->
                        <div class="col-md-6">

                            <label asp-for="UnitPrice"
                                   class="form-label fw-semibold">

                                Unit Price
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>

                                <input asp-for="UnitPrice"
                                       type="number"
                                       class="form-control"
                                       placeholder="0.00"
                                       min="0"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="UnitPrice"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Reorder Level -->
                        <div class="col-md-6">

                            <label asp-for="ReorderLevel"
                                   class="form-label fw-semibold">

                                Reorder Level
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-arrow-repeat"></i>
                                </span>

                                <input asp-for="ReorderLevel"
                                       type="number"
                                       class="form-control"
                                       placeholder="e.g. 10"
                                       min="0"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="ReorderLevel"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Active Status -->
                        <div class="col-md-6">

                            <div class="status-box">

                                <div class="form-check form-switch">

                                    <input asp-for="IsActive"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="IsActive" />

                                    <label class="form-check-label fw-semibold"
                                           for="IsActive">

                                        Active Product

                                    </label>

                                </div>

                                <small class="text-muted">
                                    Enable this option if the product is currently active.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        <i class="bi bi-x-lg me-2"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="createProductBtn">

                        <i class="bi bi-check-lg me-2"></i>
                        Create Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/Product/Create.css"
          asp-append-version="true" />

}


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Product/Create.js"
            asp-append-version="true"></script>

}