@model WarehouseManagementSystemWeb.Application.ViewModels.Product.ProductUpdateViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>

            <h3 class="fw-bold mb-1">
                Delete Product
            </h3>

            <p class="text-muted mb-0">
                Review the product information before deleting this record.
            </p>

        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Products

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm delete-card">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="delete-icon">
                    <i class="bi bi-trash3"></i>
                </div>

                <div>

                    <h5 class="fw-semibold mb-1">
                        Delete Product
                    </h5>

                    <span class="text-muted small">
                        Product information and deletion confirmation.
                    </span>

                </div>

            </div>

        </div>


        <!-- Card Body -->
        <div class="card-body p-4">

            <!-- Warning -->
            <div class="delete-warning mb-4">

                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Are you sure you want to delete this product?
                    </h6>

                    <p class="mb-0 text-muted">
                        This action cannot be undone. The product record will be permanently deleted.
                    </p>

                </div>

            </div>


            <!-- Product Information -->
            <div class="product-details">

                <div class="details-heading mb-3">

                    <h6 class="fw-bold mb-1">
                        Product Information
                    </h6>

                    <p class="text-muted small mb-0">
                        Review the following information before continuing.
                    </p>

                </div>


                <div class="row g-4">

                    <!-- Product Code -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Product Code
                            </span>

                            <span class="detail-value">
                                @Model.ProductCode
                            </span>

                        </div>

                    </div>


                    <!-- Product Name -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Product Name
                            </span>

                            <span class="detail-value">
                                @Model.ProductName
                            </span>

                        </div>

                    </div>


                    <!-- Category -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Product Category
                            </span>

                            <span class="detail-value">
                                @Model.CategoryName
                            </span>

                        </div>

                    </div>


                    <!-- Unit -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Unit of Measure
                            </span>

                            <span class="detail-value">
                                @Model.UnitName
                            </span>

                        </div>

                    </div>


                    <!-- Unit Price -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Unit Price
                            </span>

                            <span class="detail-value">
                                PKR @Model.UnitPrice.ToString("N2")
                            </span>

                        </div>

                    </div>


                    <!-- Reorder Level -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Reorder Level
                            </span>

                            <span class="detail-value">
                                @Model.ReorderLevel
                            </span>

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6">

                        <div class="detail-box">

                            <span class="detail-label">
                                Status
                            </span>

                            @if (Model.IsActive)
                            {
                                <span class="status-badge active">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="bi bi-x-circle-fill me-1"></i>
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Delete Form -->
            <form asp-controller="Product"
                  asp-action="DeleteConfirmed"
                  method="post"
                  id="deleteProductForm">

                @Html.AntiForgeryToken()

                <input asp-for="ProductId"
                       type="hidden" />


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        <i class="bi bi-x-lg me-2"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-danger px-4"
                            id="deleteProductBtn">

                        <i class="bi bi-trash3 me-2"></i>
                        Delete Product

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/Product/Delete.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="~/js/Product/Delete.js"
            asp-append-version="true"></script>

}
