@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.Warehouse.WarehouseListViewModel>

@{
    ViewData["Title"] = "Warehouses";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" data-message="@TempData["ErrorMessage"]"></div>
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Warehouses</h3>
            <p class="text-muted mb-0">Manage your warehouses and their status.</p>
        </div>
        <a asp-controller="Warehouse" asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Add Warehouse
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Warehouses</span>
                        <h3 class="fw-bold mt-2 mb-0">@(Model?.Count() ?? 0)</h3>
                    </div>
                    <div class="module-summary-icon"><i class="bi bi-box-seam fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 border-bottom">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h5 class="fw-semibold mb-1">Warehouse Directory</h5>
                    <span class="text-muted small">A complete list of registered warehouses</span>
                </div>
                <div class="position-relative module-search">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="warehouseSearch" class="form-control ps-5 py-2" placeholder="Search..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="warehouseTable">
                <thead class="bg-light">
                    <tr>

                        <th class="ps-4 text-muted small fw-semibold">WAREHOUSE</th>
                        <th class="text-muted small fw-semibold">CODE</th>
                        <th class="text-muted small fw-semibold">LOCATION</th>
                        <th class="text-muted small fw-semibold">MANAGER</th>
                        <th class="text-muted small fw-semibold">STATUS</th>
                        <th class="text-end pe-4 text-muted small fw-semibold">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="module-avatar"><i class="bi bi-box-seam"></i></div>
                                        <div>
                                            <div class="fw-semibold text-dark">@item.WarehouseName</div>
                                            <div class="text-muted small">Warehouse #@item.WarehouseId</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="module-code">@item.WarehouseCode</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "Not provided" : item.Location)</td>
                                <td>@item.EmployeeName</td>
                                <td>
                                @if (item.IsActive) { <span class="status-badge status-active"><i class="bi bi-check-circle me-1"></i>Active</span> } else { <span class="status-badge status-inactive"><i class="bi bi-x-circle me-1"></i>Inactive</span> }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Warehouse" asp-action="Detail" asp-route-id="@item.WarehouseId" class="btn btn-sm btn-light action-btn" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-controller="Warehouse" asp-action="Update" asp-route-id="@item.WarehouseId" class="btn btn-sm btn-light action-btn" title="Update"><i class="bi bi-pencil"></i></a>
                                        <a asp-controller="Warehouse" asp-action="Delete" asp-route-id="@item.WarehouseId" class="btn btn-sm btn-light action-btn delete-btn" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="text-center py-5">
                                    <div class="empty-icon mx-auto mb-3"><i class="bi bi-box-seam"></i></div>
                                    <h5 class="fw-semibold">No warehouses found</h5>
                                    <p class="text-muted mb-3">There are currently no warehouses available.</p>
                                    <a asp-controller="Warehouse" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add Warehouse</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Warehouse/Index.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/Warehouse/Index.js" asp-append-version="true"></script>
}