@model WarehouseManagementSystemWeb.Application.ViewModels.Warehouse.WarehouseUpdateViewModel

@{
    ViewData["Title"] = "Update Warehouse";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Update Warehouse</h3>
            <p class="text-muted mb-0">Update warehouse information.</p>
        </div>
        <a asp-controller="Warehouse" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="update-icon"><i class="bi bi-box-seam"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Warehouse Information</h5>
                    <span class="text-muted small">Modify the warehouse information below.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="Warehouse" asp-action="Update" method="post" id="warehouseUpdateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Warehouse Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Warehouse ID</label>
                            <input asp-for="WarehouseId" class="form-control readonly-field" readonly />
                        </div>
                        <div class="col-md-8 d-none d-md-block"></div>
                        <div class="col-md-6">
                            <label asp-for="WarehouseCode" class="form-label fw-semibold">Warehouse Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input asp-for="WarehouseCode" type="text" class="form-control" placeholder="e.g. WAR-001" autocomplete="off" />
                            </div>
                            <span asp-validation-for="WarehouseCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarehouseName" class="form-label fw-semibold">Warehouse Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input asp-for="WarehouseName" type="text" class="form-control" placeholder="Enter warehouse name" autocomplete="off" />
                            </div>
                            <span asp-validation-for="WarehouseName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold">Location</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                                <input asp-for="Location" type="text" class="form-control" placeholder="Enter location (optional)" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ManagerEmployeeId" class="form-label fw-semibold">Manager</label>
                            <select asp-for="ManagerEmployeeId" asp-items="Model.Employees" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="ManagerEmployeeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch status-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActive" />
                                <label class="form-check-label" for="IsActive" id="statusLabel">Active</label>
                            </div>
                            <small class="text-muted">Enable or disable this record.</small>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="Warehouse" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="updateWarehouseBtn"><i class="bi bi-check-lg me-2"></i>Update Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Warehouse/Update.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Warehouse/Update.js" asp-append-version="true"></script>
}
