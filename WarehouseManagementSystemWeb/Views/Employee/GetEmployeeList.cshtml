@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.Employee.EmployeeListViewModel>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid px-4 py-4">


    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">Employees</h3>
            <p class="text-muted mb-0">
                Manage your employees and their organizational information.
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="Create"
           class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-lg me-2"></i>
            Add Employee
        </a>

    </div>


    <!-- Summary Card -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>
                            <span class="text-muted small">
                                Total Employees
                            </span>

                            <h3 class="fw-bold mt-2 mb-0">
                                @Model.Count()
                            </h3>
                        </div>

                        <div class="rounded-3 bg-primary bg-opacity-10
                            text-primary d-flex align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-people fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- Toolbar -->
        <div class="card-body p-4 border-bottom">

            <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-center gap-3">

                <div>

                    <h5 class="fw-semibold mb-1">
                        Employee Directory
                    </h5>

                    <span class="text-muted small">
                        A complete list of registered employees
                    </span>

                </div>


                <!-- Search -->
                <div class="position-relative"
                     style="max-width:320px;width:100%;">

                    <i class="bi bi-search position-absolute
                    top-50 start-0 translate-middle-y
                    ms-3 text-muted"></i>

                    <input type="text"
                           id="employeeSearch"
                           class="form-control ps-5 py-2"
                           placeholder="Search employees..." />

                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="employeeTable">

                <thead class="bg-light">

                    <tr>

                        <th class="ps-4 text-muted small fw-semibold">
                            EMPLOYEE
                        </th>

                        <th class="text-muted small fw-semibold">
                            CODE
                        </th>

                        <th class="text-muted small fw-semibold">
                            CONTACT
                        </th>

                        <th class="text-muted small fw-semibold">
                            DEPARTMENT
                        </th>

                        <th class="text-muted small fw-semibold">
                            DESIGNATION
                        </th>

                        <th class="text-end pe-4 text-muted small fw-semibold">
                            ACTIONS
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var employee in Model)
                        {
                            var initials =
                                $"{employee.FirstName.FirstOrDefault()}{employee.LastName.FirstOrDefault()}";

                            <tr>

                                <!-- Employee -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="employee-avatar">

                                            @initials.ToUpper()

                                        </div>

                                        <div>

                                            <div class="fw-semibold text-dark">

                                                @employee.FirstName
                                                @employee.LastName

                                            </div>

                                            <div class="text-muted small">

                                                ID: #@employee.EmployeeId

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- Employee Code -->
                                <td>

                                    <span class="employee-code">

                                        @employee.EmployeeCode

                                    </span>

                                </td>


                                <!-- Contact -->
                                <td>

                                    <div class="d-flex flex-column gap-1">

                                        @if (!string.IsNullOrWhiteSpace(employee.Email))
                                        {
                                            <span class="small text-dark">

                                                <i class="bi bi-envelope me-2 text-muted"></i>

                                                @employee.Email

                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(employee.Phone))
                                        {
                                            <span class="small text-muted">

                                                <i class="bi bi-telephone me-2"></i>

                                                @employee.Phone

                                            </span>
                                        }

                                        @if (string.IsNullOrWhiteSpace(employee.Email)
                                            && string.IsNullOrWhiteSpace(employee.Phone))
                                        {
                                            <span class="text-muted small">
                                                No contact information
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- Department -->
                                <td>

                                    <span class="department-badge">

                                        <i class="bi bi-building me-1"></i>

                                        @employee.DepartmentName

                                    </span>

                                </td>


                                <!-- Designation -->
                                <td>

                                    <span class="text-dark small fw-medium">

                                        @employee.DesignationName

                                    </span>

                                </td>


                                <!-- Actions -->
                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <!-- Details -->
                                        <a asp-controller="Employee"
                                           asp-action="Details"
                                           asp-route-id="@employee.EmployeeId"
                                           class="btn btn-sm btn-light action-btn"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-controller="Employee"
                                           asp-action="Edit"
                                           asp-route-id="@employee.EmployeeId"
                                           class="btn btn-sm btn-light action-btn"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-controller="Employee"
                                              asp-action="Delete"
                                              asp-route-id="@employee.EmployeeId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-light
                                                action-btn delete-btn"
                                                    title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this employee?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <tr>

                            <td colspan="6">

                                <div class="text-center py-5">

                                    <div class="empty-icon mx-auto mb-3">

                                        <i class="bi bi-people"></i>

                                    </div>

                                    <h5 class="fw-semibold">
                                        No employees found
                                    </h5>

                                    <p class="text-muted mb-3">
                                        There are currently no employees available.
                                    </p>

                                    <a asp-controller="Employee"
                                       asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-2"></i>

                                        Add Employee

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/Employee/List.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/Employee/List.js"
            asp-append-version="true"></script>
}




