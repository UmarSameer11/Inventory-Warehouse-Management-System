
@model WarehouseManagementSystemWeb.Application.ViewModels.Employee.EmployeeCreateViewModel

@{
    ViewData["Title"] = "Create";
}


<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Create Employee
            </h3>

            <p class="text-muted mb-0">
                Add a new employee and assign organizational information.
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Employees

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="create-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div>
                    <h5 class="fw-semibold mb-1">
                        Employee Information
                    </h5>

                    <span class="text-muted small">
                        Enter the employee's basic and organizational details.
                    </span>
                </div>

            </div>

        </div>


        <!-- Form -->
        <div class="card-body p-4">

            <form asp-controller="Employee"
                  asp-action="Create"
                  method="post"
                  id="employeeCreateForm">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary"
                     role="alert">
                </div>


                <!-- Personal Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Personal Information
                        </h6>

                        <p class="text-muted small mb-0">
                            Basic information about the employee.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Employee Code -->
                        <div class="col-md-6">

                            <label asp-for="EmployeeCode"
                                   class="form-label fw-semibold">

                                Employee Code
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="EmployeeCode"
                                   class="form-control"
                                   placeholder="e.g. EMP-001"
                                   autocomplete="off" />

                            <span asp-validation-for="EmployeeCode"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- First Name -->
                        <div class="col-md-6">

                            <label asp-for="FirstName"
                                   class="form-label fw-semibold">

                                First Name
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter first name"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Last Name -->
                        <div class="col-md-6">

                            <label asp-for="LastName"
                                   class="form-label fw-semibold">

                                Last Name
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter last name"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- CNIC -->
                        <div class="col-md-6">

                            <label asp-for="CNIC"
                                   class="form-label fw-semibold">

                                CNIC
                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <input asp-for="CNIC"
                                   class="form-control"
                                   placeholder="XXXXX-XXXXXXX-X"
                                   maxlength="15"
                                   autocomplete="off" />

                            <span asp-validation-for="CNIC"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Contact Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Contact Information
                        </h6>

                        <p class="text-muted small mb-0">
                            Employee contact details.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Phone -->
                        <div class="col-md-6">

                            <label asp-for="Phone"
                                   class="form-label fw-semibold">

                                Phone
                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-telephone"></i>
                                </span>

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="03XXXXXXXXX"
                                       autocomplete="tel" />

                            </div>

                            <span asp-validation-for="Phone"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Email -->
                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">

                                Email
                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="employee@example.com"
                                       autocomplete="email" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Organization Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Organization Information
                        </h6>

                        <p class="text-muted small mb-0">
                            Assign department, designation and joining date.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Department -->
                        <div class="col-md-6">

                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">

                                Department
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="Model.Departments"
                                    class="form-select">

                                <option value="">
                                    Select Department
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Designation -->
                        <div class="col-md-6">

                            <label asp-for="DesignationId"
                                   class="form-label fw-semibold">

                                Designation
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="DesignationId"
                                    asp-items="Model.Designations"
                                    class="form-select">

                                <option value="">
                                    Select Designation
                                </option>

                            </select>

                            <span asp-validation-for="DesignationId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Joining Date -->
                        <div class="col-md-6">

                            <label asp-for="JoiningDate"
                                   class="form-label fw-semibold">

                                Joining Date
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>

                                <input asp-for="JoiningDate"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="JoiningDate"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        <i class="bi bi-x-lg me-2"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="createE mployeeBtn">

                        <i class="bi bi-check-lg me-2"></i>
                        Create Employee
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/Employee/Create.css"
          asp-append-version="true" />

}


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Employee/Create.js"
            asp-append-version="true"></script>

}

