@model WarehouseManagementSystemWeb.Application.ViewModels.Employee.EmployeeUpdateViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container-fluid px-4 py-4">


    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h3 class="fw-bold mb-1">
                Delete Employee
            </h3>

            <p class="text-muted mb-0">
                Review the employee information before permanently deleting this record.
            </p>

        </div>


        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Employees

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">


        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="delete-icon">
                    <i class="bi bi-person-x"></i>
                </div>

                <div>

                    <h5 class="fw-semibold mb-1">
                        Employee Information
                    </h5>

                    <span class="text-muted small">
                        Verify the employee you want to delete.
                    </span>

                </div>

            </div>

        </div>


        <!-- Card Body -->
        <div class="card-body p-4">


            <!-- Warning -->
            <div class="alert alert-warning d-flex align-items-start gap-3"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill fs-5"></i>

                <div>

                    <strong>Are you sure you want to delete this employee?</strong>

                    <div class="small mt-1">
                        This action may remove the employee record from the system.
                        Please verify the information below before continuing.
                    </div>

                </div>

            </div>


            <!-- Personal Information -->
            <div class="form-section mt-4">

                <div class="section-heading mb-4">

                    <h6 class="fw-bold mb-1">
                        Personal Information
                    </h6>

                    <p class="text-muted small mb-0">
                        Basic information about the employee.
                    </p>

                </div>


                <div class="row g-4">


                    <!-- Employee Code -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Employee Code
                        </label>

                        <div class="detail-value">
                            @Model.EmployeeCode
                        </div>

                    </div>


                    <!-- First Name -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            First Name
                        </label>

                        <div class="detail-value">
                            @Model.FirstName
                        </div>

                    </div>


                    <!-- Last Name -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Last Name
                        </label>

                        <div class="detail-value">
                            @Model.LastName
                        </div>

                    </div>


                </div>

            </div>


            <hr class="my-4" />


            <!-- Organization Information -->
            <div class="form-section">

                <div class="section-heading mb-4">

                    <h6 class="fw-bold mb-1">
                        Organization Information
                    </h6>

                    <p class="text-muted small mb-0">
                        Employee's organizational assignment.
                    </p>

                </div>


                <div class="row g-4">


                    <!-- Department -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Department
                        </label>

                        <div class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.DepartmentName)
                                ? "Not provided"
                                : Model.DepartmentName)
                        </div>

                    </div>


                    <!-- Designation -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Designation
                        </label>

                        <div class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.DesignationName)
                                ? "Not provided"
                                : Model.DesignationName)
                        </div>

                    </div>


                </div>

            </div>


            <hr class="my-4" />


            <!-- Delete Form -->
            <form asp-controller="Employee"
              asp-action="DeleteConfirmed"
               method="post"
               id="deleteEmployeeForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                    name="id"
                       asp-for=@Model.EmployeeId/>


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row
                    justify-content-end gap-2">


                    <!-- Cancel -->
                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        <i class="bi bi-x-lg me-2"></i>
                        Cancel

                    </a>


                    <!-- Delete -->
                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash3 me-2"></i>
                        Delete Employee

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Styles {

    
    <link rel="stylesheet"
          href="~/css/Employee/Delete.css"
          asp-append-version="true" />

}


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Employee/Delete.js"
            asp-append-version="true"></script>

}

