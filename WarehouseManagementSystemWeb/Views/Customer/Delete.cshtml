@model WarehouseManagementSystemWeb.Application.ViewModels.Customer.CustomerUpdateViewModel

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Customer</h3>
            <p class="text-muted mb-0">Review the information before permanently deleting this record.</p>
        </div>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-person-lines-fill"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Customer Information</h5>
                    <span class="text-muted small">Verify the record you want to delete.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Are you sure you want to delete this customer?</strong>
                    <div class="small mt-1">This action cannot be undone. Please verify the information below before continuing.</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Customer Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer ID</label>
                        <div class="detail-value">@Model.CustomerId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer Code</label>
                        <div class="detail-value">@Model.CustomerCode</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer Name</label>
                        <div class="detail-value">@Model.CustomerName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Contact Person</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.ContactPerson) ? "Not provided" : Model.ContactPerson)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Address</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">City</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.City) ? "Not provided" : Model.City)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value">@if (Model.IsActive) { <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Active</span> } else { <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span> }</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="Customer" asp-action="DeleteConfirmed" method="post" id="deleteCustomerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CustomerId" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-danger px-4" id="deleteCustomerBtn"><i class="bi bi-trash3 me-2"></i>Delete Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Customer/Delete.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/Customer/Delete.js" asp-append-version="true"></script>
}
