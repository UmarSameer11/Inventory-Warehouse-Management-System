@model WarehouseManagementSystemWeb.Application.ViewModels.Customer.CustomerUpdateViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Customer Details</h3>
            <p class="text-muted mb-0">View complete customer information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="Customer" asp-action="Update" asp-route-id="@Model.CustomerId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-person-lines-fill"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Customer Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Customer Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer ID</label>
                        <div class="detail-value">@Model.CustomerId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer Code</label>
                        <div class="detail-value">@Model.CustomerCode</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer Name</label>
                        <div class="detail-value">@Model.CustomerName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Contact Person</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.ContactPerson) ? "Not provided" : Model.ContactPerson)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Address</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">City</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.City) ? "Not provided" : Model.City)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value">@if (Model.IsActive) { <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Active</span> } else { <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span> }</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="Customer" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="Customer" asp-action="Update" asp-route-id="@Model.CustomerId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Customer</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Customer/Detail.css" asp-append-version="true" /> }
