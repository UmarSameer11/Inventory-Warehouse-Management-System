@model WarehouseManagementSystemWeb.Application.ViewModels.UnitOfMeasure.UnitOfMeasureUpdateViewModel

@{
    ViewData["Title"] = "Update Unit of Measure";
}

<div class="container-fluid px-4 py-4 unitOfMeasure-update-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Update Unit of Measure</h3>
            <p class="text-muted mb-0">Update unit of measure information and status.</p>
        </div>
        <a asp-controller="UnitOfMeasure" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="update-icon"><i class="bi bi-rulers"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Unit of Measure Information</h5>
                    <span class="text-muted small">Modify the unit of measure's information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="UnitOfMeasure" asp-action="Update" method="post" id="unitOfMeasureUpdateForm">
                @Html.AntiForgeryToken()
                <input asp-for="UnitOfMeasureId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Unit of Measure Details</h6>
                        <p class="text-muted small mb-0">Update the information below.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Unit of Measure ID</label>
                            <input asp-for="UnitOfMeasureId" class="form-control readonly-field" readonly />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UnitName" class="form-label fw-semibold">Unit Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-rulers"></i></span>
                                <input asp-for="UnitName" class="form-control" placeholder="e.g. Kilogram" autocomplete="off" />
                            </div>
                            <span asp-validation-for="UnitName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Symbol" class="form-label fw-semibold">Symbol <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-type"></i></span>
                                <input asp-for="Symbol" class="form-control" placeholder="e.g. kg" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Symbol" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="UnitOfMeasure" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="updateUnitOfMeasureBtn"><i class="bi bi-check-lg me-2"></i>Update Unit of Measure</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/UnitOfMeasure/Update.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/UnitOfMeasure/Update.js" asp-append-version="true"></script>
}