@model WarehouseManagementSystemWeb.Application.ViewModels.UnitOfMeasure.UnitOfMeasureUpdateViewModel

@{
    ViewData["Title"] = "Unit of Measure Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Unit of Measure Details</h3>
            <p class="text-muted mb-0">View complete unit of measure information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="UnitOfMeasure" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="UnitOfMeasure" asp-action="Update" asp-route-id="@Model.UnitOfMeasureId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-rulers"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Unit of Measure Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Unit of Measure Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit of Measure ID</label>
                        <div class="detail-value">@Model.UnitOfMeasureId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit Name</label>
                        <div class="detail-value">@Model.UnitName</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Symbol</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Symbol) ? "Not provided" : Model.Symbol)</div>
                    </div>

                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="UnitOfMeasure" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="UnitOfMeasure" asp-action="Update" asp-route-id="@Model.UnitOfMeasureId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Unit of Measure</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/UnitOfMeasure/Detail.css" asp-append-version="true" /> }