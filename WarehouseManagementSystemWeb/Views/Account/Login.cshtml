@model WarehouseManagementSystemWeb.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-logo"><i class="bi bi-box-seam"></i></div>
        <div>
            <h1>Warehouse Management</h1>
            <p>Secure inventory & warehouse operations</p>
        </div>
    </div>

    <div class="auth-panel">
        <div class="mb-4">
            <span class="auth-eyebrow">ACCOUNT ACCESS</span>
            <h2>Welcome back</h2>
            <p class="text-muted mb-0">Sign in to continue to your workspace.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div id="errorMessage" data-message="@TempData["ErrorMessage"]"></div>
        }

        <form asp-action="Login" method="post" novalidate id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="auth-field mb-3">
                <label asp-for="Email" class="form-label">
                    <i class="bi bi-envelope me-1"></i> Email address
                </label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" autocomplete="username"
                           placeholder="name@company.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="auth-field mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label mb-0">
                        <i class="bi bi-lock me-1"></i> Password
                    </label>
                </div>
                <div class="input-icon-wrap password-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="form-control pe-5"
                           autocomplete="current-password" placeholder="Enter your password" />
                    <button type="button" class="password-toggle" data-target="Password"
                            aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                </div>
                <span class="secure-label">
                    <i class="bi bi-shield-check me-1"></i> Secure session
                </span>
            </div>

            <button type="submit" class="btn btn-primary w-100 auth-submit" id="loginButton">
                <span class="button-text"><i class="bi bi-box-arrow-in-right me-2"></i> Sign In</span>
                <span class="button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-2"></span> Signing in...
                </span>
            </button>
        </form>
    </div>

    <div class="auth-footer">
        <i class="bi bi-shield-lock me-1"></i>
        Authentication is protected with JWT access & refresh tokens.
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Login.js" asp-append-version="true"></script>
}
