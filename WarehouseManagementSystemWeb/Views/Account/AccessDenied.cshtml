@{
    ViewData["Title"] = "Access Denied";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}

<div class="access-denied-page">
    <div class="access-denied-card">
        <div class="access-denied-icon"><i class="bi bi-shield-lock"></i></div>
        <span class="page-eyebrow">SECURITY</span>
        <h2>Access denied</h2>
        <p class="text-muted">
            Your current account does not have permission to access this resource.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Employee" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-arrow-left me-2"></i> Back to workspace
            </a>
        }
        else
        {
            <a asp-action="Login" class="btn btn-primary px-4">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign in
            </a>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Account/Account.css" asp-append-version="true" />
}
