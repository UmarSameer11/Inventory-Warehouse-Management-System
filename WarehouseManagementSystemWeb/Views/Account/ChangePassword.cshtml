@model WarehouseManagementSystemWeb.Models.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid px-4 py-4 account-page">
    <div class="page-header mb-4">
        <span class="page-eyebrow">ACCOUNT SECURITY</span>
        <h3 class="fw-bold mb-1">Change Password</h3>
        <p class="text-muted mb-0">Update your password and protect your account.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-7">
            <div class="account-card">
                <div class="account-card-header">
                    <div class="account-icon"><i class="bi bi-key"></i></div>
                    <div>
                        <h5 class="mb-1">Password update</h5>
                        <p class="text-muted small mb-0">Other active devices will be signed out after this change.</p>
                    </div>
                </div>

                <div class="account-card-body">
                    <form asp-action="ChangePassword" method="post" novalidate id="changePasswordForm">
                        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <div class="input-icon-wrap password-wrap">
                                <i class="bi bi-lock"></i>
                                <input asp-for="CurrentPassword" class="form-control pe-5"
                                       autocomplete="current-password" placeholder="Current password" />
                                <button type="button" class="password-toggle" data-target="CurrentPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <div class="input-icon-wrap password-wrap">
                                <i class="bi bi-lock"></i>
                                <input asp-for="NewPassword" class="form-control pe-5"
                                       autocomplete="new-password" placeholder="New password" />
                                <button type="button" class="password-toggle" data-target="NewPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <div class="input-icon-wrap password-wrap">
                                <i class="bi bi-lock-fill"></i>
                                <input asp-for="ConfirmNewPassword" class="form-control pe-5"
                                       autocomplete="new-password" placeholder="Repeat new password" />
                                <button type="button" class="password-toggle" data-target="ConfirmNewPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="password-policy mb-4">
                            <div class="fw-semibold mb-2">
                                <i class="bi bi-shield-check me-2"></i>Security recommendation
                            </div>
                            <div class="small text-muted">
                                Use a unique password with uppercase, lowercase, number and special character.
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                            <a asp-action="Profile" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4" id="changePasswordButton">
                                <span class="button-text"><i class="bi bi-key me-2"></i>Change Password</span>
                                <span class="button-loading d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span> Updating...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Account/Account.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/ChangePassword.js" asp-append-version="true"></script>
}
