@model WarehouseManagementSystemWeb.Models.Auth.RegisterUserViewModel
@using WarehouseManagementSystemWeb.Auth
@{
    ViewData["Title"] = "Register User";
}

<div class="container-fluid px-4 py-4 account-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
    }

    <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="page-eyebrow">USER MANAGEMENT</span>
            <h3 class="fw-bold mb-1">Register New User</h3>
            <p class="text-muted mb-0">Create a secure account and assign its application role.</p>
        </div>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-light border">
            <i class="bi bi-arrow-left me-2"></i> Back to Profile
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-xxl-7">
            <div class="account-card">
                <div class="account-card-header">
                    <div class="account-icon"><i class="bi bi-person-plus"></i></div>
                    <div>
                        <h5 class="mb-1">Account details</h5>
                        <p class="text-muted small mb-0">Only administrators can create new users.</p>
                    </div>
                </div>

                <div class="account-card-body">
                    <form asp-action="Register" method="post" novalidate id="registerForm">
                        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <div class="input-icon-wrap">
                                    <i class="bi bi-person"></i>
                                    <input asp-for="Name" class="form-control" placeholder="Full name" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <div class="input-icon-wrap">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="Email" class="form-control" autocomplete="off"
                                           placeholder="name@company.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label"></label>
                                <div class="input-icon-wrap select-wrap">
                                    <i class="bi bi-shield-check"></i>
                                    <select asp-for="Role" class="form-select"
                                            asp-items="@(AuthConstants.AllRoles.Select(r => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(r, r)))">
                                    </select>
                                </div>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="role-hint w-100">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Assign the minimum role required for the user's responsibilities.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <div class="input-icon-wrap password-wrap">
                                    <i class="bi bi-lock"></i>
                                    <input asp-for="Password" class="form-control pe-5"
                                           autocomplete="new-password" placeholder="Create password" />
                                    <button type="button" class="password-toggle" data-target="Password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <div class="input-icon-wrap password-wrap">
                                    <i class="bi bi-lock-fill"></i>
                                    <input asp-for="ConfirmPassword" class="form-control pe-5"
                                           autocomplete="new-password" placeholder="Repeat password" />
                                    <button type="button" class="password-toggle" data-target="ConfirmPassword">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="password-policy mt-4">
                            <div class="fw-semibold mb-2"><i class="bi bi-shield-lock me-2"></i>Password policy</div>
                            <div class="small text-muted">Minimum 8 characters with uppercase, lowercase, number and special character.</div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-4">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4" id="registerButton">
                                <span class="button-text"><i class="bi bi-person-plus me-2"></i>Create User</span>
                                <span class="button-loading d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span> Creating...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Account/Account.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account/Register.js" asp-append-version="true"></script>
}
