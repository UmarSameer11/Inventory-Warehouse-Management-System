@model WarehouseManagementSystemWeb.Application.ViewModels.Dispatch.DispatchCreateViewModel

@{
    ViewData["Title"] = "Create Dispatch";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Create Dispatch</h3>
            <p class="text-muted mb-0">Add a new dispatch to the system.</p>
        </div>
        <a asp-controller="Dispatch" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="create-icon"><i class="bi bi-send"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Dispatch Information</h5>
                    <span class="text-muted small">Enter the information for the new dispatch.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="Dispatch" asp-action="Create" method="post" id="dispatchCreateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Dispatch Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="DispatchNumber" class="form-label fw-semibold">Dispatch Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="DispatchNumber" type="text" class="form-control" placeholder="Enter dispatch number" autocomplete="off" />
                            </div>
                            <span asp-validation-for="DispatchNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalesOrderId" class="form-label fw-semibold">Sales Order <span class="text-danger">*</span></label>
                            <select asp-for="SalesOrderId" asp-items="Model.SalesOrders" class="form-select">
                                <option value="">-- Select Sales Order --</option>
                            </select>
                            <span asp-validation-for="SalesOrderId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarehouseId" class="form-label fw-semibold">Warehouse <span class="text-danger">*</span></label>
                            <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                                <option value="">-- Select Warehouse --</option>
                            </select>
                            <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VehicleId" class="form-label fw-semibold">Vehicle <span class="text-danger">*</span></label>
                            <select asp-for="VehicleId" asp-items="Model.Vehicles" class="form-select">
                                <option value="">-- Select Vehicle --</option>
                            </select>
                            <span asp-validation-for="VehicleId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DispatchDate" class="form-label fw-semibold">Dispatch Date <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DispatchDate" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="DispatchDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-flag"></i></span>
                                <input asp-for="Status" type="text" class="form-control" placeholder="e.g. Pending" autocomplete="off" list="statusOptions" />
                                <datalist id="statusOptions"><option value="Pending"></option><option value="Approved"></option><option value="Completed"></option><option value="Cancelled"></option></datalist>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="Dispatch" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="createDispatchBtn"><i class="bi bi-check-lg me-2"></i>Create Dispatch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Dispatch/Create.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Dispatch/Create.js" asp-append-version="true"></script>
}
