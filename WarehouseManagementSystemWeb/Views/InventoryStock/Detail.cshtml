@model WarehouseManagementSystemWeb.Application.ViewModels.InventoryStock.InventoryStockUpdateViewModel

@{
    ViewData["Title"] = "Stock Details";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Stock Details</h3>
            <p class="text-muted mb-0">View complete inventory stock information.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="InventoryStock" asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
            <a asp-controller="InventoryStock" asp-action="Update" asp-route-id="@Model.InventoryStockId" class="btn btn-primary px-4">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-boxes"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Stock Information</h5>
                    <span class="text-muted small">Complete information and current stock levels.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="form-section">

                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Stock Location</h6>
                    <p class="text-muted small mb-0">Where this stock is kept.</p>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Stock ID</label>
                        <div class="detail-value">@Model.InventoryStockId</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Warehouse</label>
                        <div class="detail-value">@Model.WarehouseName</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@Model.ProductName</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Batch</label>
                        <div class="detail-value">@Model.BatchNumber</div>
                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="form-section">

                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Quantities</h6>
                    <p class="text-muted small mb-0">Current stock levels.</p>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Quantity</label>
                        <div class="detail-value">@Model.Quantity.ToString("N2")</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Reserved Quantity</label>
                        <div class="detail-value">@Model.ReservedQuantity.ToString("N2")</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Available Quantity</label>
                        <div class="detail-value">
                            @if (Model.AvailableQuantity > 0)
                            {
                                <span class="badge bg-success-subtle text-success">@Model.AvailableQuantity.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">@Model.AvailableQuantity.ToString("N2")</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Last Updated</label>
                        <div class="detail-value">
                            @(Model.HasLastUpdated ? Model.LastUpdated.ToString("dd MMM yyyy, hh:mm tt") : "Not available")
                        </div>
                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="InventoryStock" asp-action="Index" class="btn btn-light border px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back
                </a>
                <a asp-controller="InventoryStock" asp-action="Delete" asp-route-id="@Model.InventoryStockId" class="btn btn-outline-danger px-4">
                    <i class="bi bi-trash3 me-2"></i>Delete
                </a>
                <a asp-controller="InventoryStock" asp-action="Update" asp-route-id="@Model.InventoryStockId" class="btn btn-primary px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit Stock
                </a>
            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/InventoryStock/Detail.css" asp-append-version="true" />
}
