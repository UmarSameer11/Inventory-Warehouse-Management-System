
@using WarehouseManagementSystemWeb.Application.ViewModels.PurchaseOrder

@model IEnumerable<PurchaseOrderListViewModel>

@{
    ViewData["Title"] = "Purchase Orders";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/PurchaseOrder/Index.css"
          asp-append-version="true" />
}

<div class="po-list-page">

    <!-- PAGE HEADER -->
    <div class="po-list-heading">
        <div>
            <span class="po-list-eyebrow">INVENTORY MANAGEMENT</span>
            <h2>Purchase Orders</h2>
            <p>Manage purchase orders and track supplier orders.</p>
        </div>

        <a asp-controller="PurchaseOrder"
           asp-action="Create"
           class="po-create-btn">
            <i class="bi bi-plus-circle"></i>
            Create Purchase Order
        </a>
    </div>

    <!-- SUMMARY -->
    <div class="po-summary-grid">

        <div class="po-summary-card">
            <div class="po-summary-icon blue">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <span>Total Purchase Orders</span>
                <h3 id="totalOrders">@Model.Count()</h3>
            </div>
        </div>

        <div class="po-summary-card">
            <div class="po-summary-icon green">
                <i class="bi bi-currency-exchange"></i>
            </div>
            <div>
                <span>Total Order Value</span>
                <h3>
                    @Model.Sum(x => x.GrandTotal).ToString("N2")
                </h3>
            </div>
        </div>

        <div class="po-summary-card">
            <div class="po-summary-icon orange">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <span>Total Products Ordered</span>
                <h3>@Model.Sum(x => x.TotalProducts)</h3>
            </div>
        </div>

    </div>

    <!-- PURCHASE ORDER TABLE -->
    <section class="po-list-card">

        <div class="po-list-card-header">
            <div>
                <h5>Purchase Order List</h5>
                <p>View and manage your purchase orders.</p>
            </div>

            <span class="po-record-count">
                <span id="visibleOrders">@Model.Count()</span> records
            </span>
        </div>

        <!-- SEARCH AND FILTERS -->
        <div class="po-list-toolbar">

            <div class="po-search-box">
                <i class="bi bi-search"></i>
                <input type="search"
                       id="poSearch"
                       class="form-control"
                       placeholder="Search PO number or supplier..." />
            </div>

            <select id="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in Model
                    .Select(x => x.Status)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .OrderBy(x => x))
                {
                    <option value="@status">@status</option>
                }
            </select>

        </div>

        <div class="po-list-table-wrapper">

            <table class="table po-list-table align-middle">

                <thead>
                    <tr>
                        <th>Purchase Order</th>
                        <th>Supplier</th>
                        <th>Order Date</th>
                        <th>Expected Delivery</th>
                        <th>Products</th>
                        <th>Grand Total</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="purchaseOrderRows">

                    @if (Model.Any())
                    {
                        @foreach (var po in Model)
                        {
                            <tr class="po-list-row"
                                data-search="@($"{po.PurchaseOrderNumber} {po.SupplierName}".ToLowerInvariant())"
                                data-status="@po.Status.ToLowerInvariant()">

                                <td>
                                    <div class="po-number-cell">
                                        <span class="po-number-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </span>
                                        <div>
                                            <strong>@po.PurchaseOrderNumber</strong>
                                            <small>ID: @po.PurchaseOrderId</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="po-supplier-name">
                                        @po.SupplierName
                                    </span>
                                </td>

                                <td>
                                    @po.OrderDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (po.ExpectedDeliveryDate.HasValue)
                                    {
                                        @po.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="po-muted">Not specified</span>
                                    }
                                </td>

                                <td>
                                    <span class="po-product-count">
                                        <i class="bi bi-box-seam"></i>
                                        @po.TotalProducts
                                    </span>
                                </td>

                                <td>
                                    <strong class="po-amount">
                                        @po.GrandTotal.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="po-status-badge"
                                          data-status="@po.Status.ToLowerInvariant()">
                                        @po.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="po-row-actions">

                                        <a asp-controller="PurchaseOrder"
                                           asp-action="Detail"
                                           asp-route-id="@po.PurchaseOrderId"
                                           class="po-action-btn details-btn"
                                           title="View Details"
                                           aria-label="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="PurchaseOrder"
                                           asp-action="Update"
                                           asp-route-id="@po.PurchaseOrderId"
                                           class="po-action-btn edit-btn"
                                           title="Edit Purchase Order"
                                           aria-label="Edit Purchase Order">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="po-empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <h5>No Purchase Orders Found</h5>
                                    <p>Create your first purchase order to get started.</p>

                                    <a asp-controller="PurchaseOrder"
                                       asp-action="Create"
                                       class="po-create-btn">
                                        <i class="bi bi-plus-circle"></i>
                                        Create Purchase Order
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

            <div id="poNoResults" class="po-no-results" hidden>
                <i class="bi bi-search"></i>
                <p>No purchase orders match your search.</p>
            </div>

        </div>

    </section>

</div>

@section Scripts {
    <script src="~/js/PurchaseOrder/Index.js"
            asp-append-version="true"></script>
}
