@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.StockMovement.StockMovementListViewModel>

@{
    ViewData["Title"] = "Stock Movements";

    var lookups = ViewData["Lookups"] as WarehouseManagementSystemWeb.Application.ViewModels.StockMovement.StockMovementCreateViewModel;

    string Lookup(IEnumerable<SelectListItem>? items, int id)
        => items?.FirstOrDefault(i => i.Value == id.ToString())?.Text ?? $"#{id}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" data-message="@TempData["ErrorMessage"]"></div>
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Stock Movements</h3>
            <p class="text-muted mb-0">Manage every movement of stock in and out of warehouses.</p>
        </div>
        <a asp-controller="StockMovement" asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Add Stock Movement
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Stock Movements</span>
                        <h3 class="fw-bold mt-2 mb-0">@(Model?.Count() ?? 0)</h3>
                    </div>
                    <div class="module-summary-icon"><i class="bi bi-arrow-left-right fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 border-bottom">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h5 class="fw-semibold mb-1">Stock Movement Directory</h5>
                    <span class="text-muted small">A complete list of stock movements</span>
                </div>
                <div class="position-relative module-search">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="stockMovementSearch" class="form-control ps-5 py-2" placeholder="Search..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="stockMovementTable">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-muted small fw-semibold">STOCK MOVEMENT</th>
                        <th class="text-muted small fw-semibold">PRODUCT</th>
                        <th class="text-muted small fw-semibold">BATCH</th>
                        <th class="text-muted small fw-semibold">QUANTITY</th>
                        <th class="text-muted small fw-semibold">MOVEMENT TYPE</th>
                        <th class="text-muted small fw-semibold">MOVEMENT DATE</th>
                        <th class="text-muted small fw-semibold">REFERENCE NUMBER</th>
                        <th class="text-muted small fw-semibold">EMPLOYEE</th>
                        <th class="text-end pe-4 text-muted small fw-semibold">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="module-avatar"><i class="bi bi-arrow-left-right"></i></div>
                                        <div>
                                            <div class="fw-semibold text-dark">@Lookup(lookups?.Warehouses, item.WarehouseId)</div>
                                            <div class="text-muted small">Stock Movement #@item.StockMovementId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@Lookup(lookups?.Products, item.ProductId)</td>
                                <td>@(item.BatchId.HasValue ? Lookup(lookups?.Batches, item.BatchId.Value) : "—")</td>
                                <td>@item.Quantity.ToString("N2")</td>
                                <td>@item.MovementType</td>
                                <td>@item.MovementDate.ToString("dd MMM yyyy")</td>
                                <td>@if (string.IsNullOrWhiteSpace(item.ReferenceNumber)) { <span class="text-muted">—</span> } else { <span class="module-code">@item.ReferenceNumber</span> }</td>
                                <td>@(item.EmployeeId.HasValue ? Lookup(lookups?.Employees, item.EmployeeId.Value) : "—")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="StockMovement" asp-action="Detail" asp-route-id="@item.StockMovementId" class="btn btn-sm btn-light action-btn" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-controller="StockMovement" asp-action="Update" asp-route-id="@item.StockMovementId" class="btn btn-sm btn-light action-btn" title="Update"><i class="bi bi-pencil"></i></a>
                                        <a asp-controller="StockMovement" asp-action="Delete" asp-route-id="@item.StockMovementId" class="btn btn-sm btn-light action-btn delete-btn" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="text-center py-5">
                                    <div class="empty-icon mx-auto mb-3"><i class="bi bi-arrow-left-right"></i></div>
                                    <h5 class="fw-semibold">No stock movements found</h5>
                                    <p class="text-muted mb-3">There are currently no stock movements available.</p>
                                    <a asp-controller="StockMovement" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add Stock Movement</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/StockMovement/Index.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/StockMovement/Index.js" asp-append-version="true"></script>
}
