@model WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceiptDetail.GoodsReceiptDetailUpdateViewModel

@{
    ViewData["Title"] = "Goods Receipt Detail Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Goods Receipt Detail Details</h3>
            <p class="text-muted mb-0">View complete goods receipt detail information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="GoodsReceiptDetail" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="GoodsReceiptDetail" asp-action="Update" asp-route-id="@Model.GoodsReceiptDetailId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-card-checklist"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Goods Receipt Detail Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Line Item Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Goods Receipt Detail ID</label>
                        <div class="detail-value">@Model.GoodsReceiptDetailId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Goods Receipt</label>
                        <div class="detail-value">@(Model.GoodsReceipts.FirstOrDefault(x => x.Value == Model.GoodsReceiptId.ToString())?.Text ?? ("#" + Model.GoodsReceiptId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@(Model.Products.FirstOrDefault(x => x.Value == Model.ProductId.ToString())?.Text ?? ("#" + Model.ProductId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Batch</label>
                        <div class="detail-value">@(Model.Batches.FirstOrDefault(x => x.Value == Model.BatchId.ToString())?.Text ?? (Model.BatchId.HasValue ? "#" + Model.BatchId : "Not provided"))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Quantity</label>
                        <div class="detail-value">@Model.Quantity.ToString("N2")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit Price</label>
                        <div class="detail-value">@Model.UnitPrice.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="GoodsReceiptDetail" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="GoodsReceiptDetail" asp-action="Update" asp-route-id="@Model.GoodsReceiptDetailId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Goods Receipt Detail</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/GoodsReceiptDetail/Detail.css" asp-append-version="true" /> }
