@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.Batch.BatchListViewModel>

@{
    ViewData["Title"] = "Batches";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" data-message="@TempData["ErrorMessage"]"></div>
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Batches</h3>
            <p class="text-muted mb-0">Track product batches with their manufacturing and expiry dates.</p>
        </div>

        <a asp-controller="Batch" asp-action="Create" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-lg me-2"></i>
            Add Batch
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small">Total Batches</span>
                            <h3 class="fw-bold mt-2 mb-0">@(Model?.Count() ?? 0)</h3>
                        </div>
                        <div class="batch-summary-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-layers fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small">Valid</span>
                            <h3 class="fw-bold mt-2 mb-0">@(Model?.Count(b => !b.IsExpired && !b.IsExpiringSoon) ?? 0)</h3>
                        </div>
                        <div class="batch-summary-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small">Expiring in 30 Days</span>
                            <h3 class="fw-bold mt-2 mb-0">@(Model?.Count(b => b.IsExpiringSoon) ?? 0)</h3>
                        </div>
                        <div class="batch-summary-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small">Expired</span>
                            <h3 class="fw-bold mt-2 mb-0">@(Model?.Count(b => b.IsExpired) ?? 0)</h3>
                        </div>
                        <div class="batch-summary-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-x-octagon fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- Toolbar -->
        <div class="card-body p-4 border-bottom">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                <div>
                    <h5 class="fw-semibold mb-1">Batch Register</h5>
                    <span class="text-muted small">A complete list of registered batches</span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 batch-toolbar">

                    <!-- Status filter -->
                    <select id="batchStatusFilter" class="form-select" aria-label="Filter by status">
                        <option value="">All Statuses</option>
                        <option value="valid">Valid</option>
                        <option value="expiring">Expiring Soon</option>
                        <option value="expired">Expired</option>
                        <option value="noexpiry">No Expiry</option>
                    </select>

                    <!-- Search -->
                    <div class="position-relative batch-search">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input type="text"
                               id="batchSearch"
                               class="form-control ps-5 py-2"
                               placeholder="Search batches..." />
                    </div>

                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="batchTable">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-muted small fw-semibold">BATCH</th>
                        <th class="text-muted small fw-semibold">PRODUCT</th>
                        <th class="text-muted small fw-semibold">MANUFACTURED</th>
                        <th class="text-muted small fw-semibold">EXPIRY</th>
                        <th class="text-muted small fw-semibold">STATUS</th>
                        <th class="text-end pe-4 text-muted small fw-semibold">ACTIONS</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var batch in Model)
                        {
                            var status = !batch.HasExpiry ? "noexpiry"
                                       : batch.IsExpired ? "expired"
                                       : batch.IsExpiringSoon ? "expiring"
                                       : "valid";

                            <tr data-status="@status">

                                <!-- Batch -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="batch-avatar">
                                            <i class="bi bi-layers"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@batch.BatchNumber</div>
                                            <div class="text-muted small">ID: #@batch.BatchId</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Product -->
                                <td>
                                    <span class="product-badge">
                                        <i class="bi bi-box-seam me-1"></i>
                                        @batch.ProductName
                                    </span>
                                </td>

                                <!-- Manufacturing Date -->
                                <td>
                                    <span class="text-dark small fw-medium">
                                        @batch.ManufacturingDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <!-- Expiry Date -->
                                <td>
                                    @if (batch.HasExpiry)
                                    {
                                        var days = (batch.ExpiryDate!.Value.Date - DateTime.Today).Days;

                                        <div class="text-dark small fw-medium">
                                            @batch.ExpiryDate.Value.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="text-muted expiry-hint">
                                            @if (days < 0)
                                            {
                                                @:Expired @(-days) day(s) ago
                                            }
                                            else if (days == 0)
                                            {
                                                @:Expires today
                                            }
                                            else
                                            {
                                                @:@days day(s) left
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    @switch (status)
                                    {
                                        case "expired":
                                            <span class="status-badge status-expired"><i class="bi bi-x-octagon me-1"></i>Expired</span>
                                            break;
                                        case "expiring":
                                            <span class="status-badge status-expiring"><i class="bi bi-hourglass-split me-1"></i>Expiring Soon</span>
                                            break;
                                        case "noexpiry":
                                            <span class="status-badge status-noexpiry"><i class="bi bi-infinity me-1"></i>No Expiry</span>
                                            break;
                                        default:
                                            <span class="status-badge status-active"><i class="bi bi-check-circle me-1"></i>Valid</span>
                                            break;
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Batch" asp-action="Detail" asp-route-id="@batch.BatchId"
                                           class="btn btn-sm btn-light action-btn" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Batch" asp-action="Update" asp-route-id="@batch.BatchId"
                                           class="btn btn-sm btn-light action-btn" title="Update">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="Batch" asp-action="Delete" asp-route-id="@batch.BatchId"
                                           class="btn btn-sm btn-light action-btn" title="Delete">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <tr>
                            <td colspan="6">
                                <div class="text-center py-5">
                                    <div class="empty-icon mx-auto mb-3">
                                        <i class="bi bi-layers"></i>
                                    </div>
                                    <h5 class="fw-semibold">No batches found</h5>
                                    <p class="text-muted mb-3">There are currently no batches available.</p>
                                    <a asp-controller="Batch" asp-action="Create" class="btn btn-primary">
                                        <i class="bi bi-plus-lg me-2"></i>
                                        Add Batch
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            <!-- Shown by Index.js when search / filter hides every row -->
            <div id="batchNoResult" class="text-center text-muted py-5 batch-no-result">
                <i class="bi bi-search fs-3 d-block mb-2"></i>
                No batches match your search.
            </div>
        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Batch/Index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/Batch/Index.js" asp-append-version="true"></script>
}
