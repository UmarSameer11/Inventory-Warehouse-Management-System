@model WarehouseManagementSystemWeb.Application.ViewModels.Batch.BatchUpdateViewModel

@{
    ViewData["Title"] = "Delete Batch";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Batch</h3>
            <p class="text-muted mb-0">Review the batch information before deleting this record.</p>
        </div>

        <a asp-controller="Batch" asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Batches
        </a>
    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-sm delete-card">

        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-trash3"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Delete Batch</h5>
                    <span class="text-muted small">Batch information and deletion confirmation.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- Warning -->
            <div class="delete-warning mb-4">
                <div class="warning-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Are you sure you want to delete this batch?</h6>
                    <p class="mb-0 text-muted">
                        This action cannot be undone. A batch that is used by inventory stock records cannot be deleted.
                    </p>
                </div>
            </div>

            <!-- Batch Information -->
            <div class="batch-details">

                <div class="details-heading mb-3">
                    <h6 class="fw-bold mb-1">Batch Information</h6>
                    <p class="text-muted small mb-0">Review the following information before continuing.</p>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">Batch Number</span>
                            <span class="detail-value">@Model.BatchNumber</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">Product</span>
                            <span class="detail-value">@Model.ProductName</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">Manufacturing Date</span>
                            <span class="detail-value">@Model.ManufacturingDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-box">
                            <span class="detail-label">Expiry Date</span>
                            <span class="detail-value">@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd MMM yyyy") : "No expiry date")</span>
                        </div>
                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <!-- Delete Form -->
            <form asp-controller="Batch"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.BatchId"
                  method="post"
                  id="deleteBatchForm">

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="Batch" asp-action="Index" class="btn btn-light border px-4">
                        <i class="bi bi-x-lg me-2"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger px-4" id="deleteBatchBtn">
                        <i class="bi bi-trash3 me-2"></i>
                        Delete Batch
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Batch/Delete.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/Batch/Delete.js" asp-append-version="true"></script>
}
