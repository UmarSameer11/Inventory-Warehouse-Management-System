@model WarehouseManagementSystemWeb.Application.ViewModels.Batch.BatchUpdateViewModel

@{
    ViewData["Title"] = "Batch Details";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Batch Details</h3>
            <p class="text-muted mb-0">View complete batch information.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Batch" asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
            <a asp-controller="Batch" asp-action="Update" asp-route-id="@Model.BatchId" class="btn btn-primary px-4">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-layers"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Batch Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="form-section">

                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Batch Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Batch ID</label>
                        <div class="detail-value">@Model.BatchId</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Batch Number</label>
                        <div class="detail-value">@Model.BatchNumber</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.ProductName) ? "Not provided" : Model.ProductName)</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value">
                            @if (!Model.ExpiryDate.HasValue)
                            {
                                <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-infinity me-1"></i>No Expiry</span>
                            }
                            else if (Model.IsExpired)
                            {
                                <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-octagon me-1"></i>Expired</span>
                            }
                            else if (Model.IsExpiringSoon)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split me-1"></i>Expiring Soon</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Valid</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Manufacturing Date</label>
                        <div class="detail-value">@Model.ManufacturingDate.ToString("dd MMM yyyy")</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Expiry Date</label>
                        <div class="detail-value">@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd MMM yyyy") : "No expiry date")</div>
                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="Batch" asp-action="Index" class="btn btn-light border px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back
                </a>
                <a asp-controller="Batch" asp-action="Delete" asp-route-id="@Model.BatchId" class="btn btn-outline-danger px-4">
                    <i class="bi bi-trash3 me-2"></i>Delete
                </a>
                <a asp-controller="Batch" asp-action="Update" asp-route-id="@Model.BatchId" class="btn btn-primary px-4">
                    <i class="bi bi-pencil-square me-2"></i>Edit Batch
                </a>
            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Batch/Detail.css" asp-append-version="true" />
}
