@model WarehouseManagementSystemWeb.Application.ViewModels.SalesReturn.SalesReturnUpdateViewModel

@{
    ViewData["Title"] = "Sales Return Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Sales Return Details</h3>
            <p class="text-muted mb-0">View complete sales return information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="SalesReturn" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="SalesReturn" asp-action="Update" asp-route-id="@Model.SalesReturnId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Sales Return Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Sales Return Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Sales Return ID</label>
                        <div class="detail-value">@Model.SalesReturnId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Return Number</label>
                        <div class="detail-value">@Model.ReturnNumber</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Customer</label>
                        <div class="detail-value">@(Model.Customers.FirstOrDefault(x => x.Value == Model.CustomerId.ToString())?.Text ?? ("#" + Model.CustomerId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Sales Order</label>
                        <div class="detail-value">@(Model.SalesOrders.FirstOrDefault(x => x.Value == Model.SalesOrderId.ToString())?.Text ?? (Model.SalesOrderId.HasValue ? "#" + Model.SalesOrderId : "Not provided"))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Salesman</label>
                        <div class="detail-value">@(Model.Salesmen.FirstOrDefault(x => x.Value == Model.SalesmanId.ToString())?.Text ?? (Model.SalesmanId.HasValue ? "#" + Model.SalesmanId : "Not provided"))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Return Date</label>
                        <div class="detail-value">@Model.ReturnDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Remarks</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "Not provided" : Model.Remarks)</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="SalesReturn" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="SalesReturn" asp-action="Update" asp-route-id="@Model.SalesReturnId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Sales Return</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/SalesReturn/Detail.css" asp-append-version="true" /> }
