@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.SalesReturnDetail.SalesReturnDetailListViewModel>

@{
    ViewData["Title"] = "Sales Return Details";

    var lookups = ViewData["Lookups"] as WarehouseManagementSystemWeb.Application.ViewModels.SalesReturnDetail.SalesReturnDetailCreateViewModel;

    string Lookup(IEnumerable<SelectListItem>? items, int id)
        => items?.FirstOrDefault(i => i.Value == id.ToString())?.Text ?? $"#{id}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage" data-message="@TempData["SuccessMessage"]"></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage" data-message="@TempData["ErrorMessage"]"></div>
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Sales Return Details</h3>
            <p class="text-muted mb-0">Manage the product lines of sales returns.</p>
        </div>
        <a asp-controller="SalesReturnDetail" asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Add Sales Return Detail
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small">Total Sales Return Details</span>
                        <h3 class="fw-bold mt-2 mb-0">@(Model?.Count() ?? 0)</h3>
                    </div>
                    <div class="module-summary-icon"><i class="bi bi-card-list fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 border-bottom">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <h5 class="fw-semibold mb-1">Sales Return Detail Directory</h5>
                    <span class="text-muted small">A complete list of sales return details</span>
                </div>
                <div class="position-relative module-search">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" id="salesReturnDetailSearch" class="form-control ps-5 py-2" placeholder="Search..." />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="salesReturnDetailTable">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-muted small fw-semibold">SALES RETURN DETAIL</th>
                        <th class="text-muted small fw-semibold">PRODUCT</th>
                        <th class="text-muted small fw-semibold">BATCH</th>
                        <th class="text-muted small fw-semibold">QUANTITY</th>
                        <th class="text-muted small fw-semibold">RETURN REASON</th>
                        <th class="text-muted small fw-semibold">CONDITION</th>
                        <th class="text-end pe-4 text-muted small fw-semibold">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="module-avatar"><i class="bi bi-card-list"></i></div>
                                        <div>
                                            <div class="fw-semibold text-dark">@Lookup(lookups?.SalesReturns, item.SalesReturnId)</div>
                                            <div class="text-muted small">Sales Return Detail #@item.SalesReturnDetailId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@Lookup(lookups?.Products, item.ProductId)</td>
                                <td>@(item.BatchId.HasValue ? Lookup(lookups?.Batches, item.BatchId.Value) : "—")</td>
                                <td>@item.Quantity.ToString("N2")</td>
                                <td>@Lookup(lookups?.ReturnReasons, item.ReturnReasonId)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Condition) ? "—" : item.Condition)</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="SalesReturnDetail" asp-action="Detail" asp-route-id="@item.SalesReturnDetailId" class="btn btn-sm btn-light action-btn" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-controller="SalesReturnDetail" asp-action="Update" asp-route-id="@item.SalesReturnDetailId" class="btn btn-sm btn-light action-btn" title="Update"><i class="bi bi-pencil"></i></a>
                                        <a asp-controller="SalesReturnDetail" asp-action="Delete" asp-route-id="@item.SalesReturnDetailId" class="btn btn-sm btn-light action-btn delete-btn" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="text-center py-5">
                                    <div class="empty-icon mx-auto mb-3"><i class="bi bi-card-list"></i></div>
                                    <h5 class="fw-semibold">No sales return details found</h5>
                                    <p class="text-muted mb-3">There are currently no sales return details available.</p>
                                    <a asp-controller="SalesReturnDetail" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add Sales Return Detail</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/SalesReturnDetail/Index.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/SalesReturnDetail/Index.js" asp-append-version="true"></script>
}
