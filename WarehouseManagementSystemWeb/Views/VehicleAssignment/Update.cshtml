@model WarehouseManagementSystemWeb.Application.ViewModels.VehicleAssignment.VehicleAssignmentUpdateViewModel

@{
    ViewData["Title"] = "Update Vehicle Assignment";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Update Vehicle Assignment</h3>
            <p class="text-muted mb-0">Update vehicle assignment information.</p>
        </div>
        <a asp-controller="VehicleAssignment" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="update-icon"><i class="bi bi-person-check"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Vehicle Assignment Information</h5>
                    <span class="text-muted small">Modify the vehicle assignment information below.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="VehicleAssignment" asp-action="Update" method="post" id="vehicleAssignmentUpdateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Vehicle Assignment Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Vehicle Assignment ID</label>
                            <input asp-for="VehicleAssignmentId" class="form-control readonly-field" readonly />
                        </div>
                        <div class="col-md-8 d-none d-md-block"></div>
                        <div class="col-md-6">
                            <label asp-for="VehicleId" class="form-label fw-semibold">Vehicle <span class="text-danger">*</span></label>
                            <select asp-for="VehicleId" asp-items="Model.Vehicles" class="form-select">
                                <option value="">-- Select Vehicle --</option>
                            </select>
                            <span asp-validation-for="VehicleId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmployeeId" class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                            <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                                <option value="">-- Select Employee --</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignmentDate" class="form-label fw-semibold">Assignment Date <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="AssignmentDate" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="AssignmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReturnDate" class="form-label fw-semibold">Return Date</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="ReturnDate" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch status-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActive" />
                                <label class="form-check-label" for="IsActive" id="statusLabel">Active</label>
                            </div>
                            <small class="text-muted">Enable or disable this record.</small>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="VehicleAssignment" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="updateVehicleAssignmentBtn"><i class="bi bi-check-lg me-2"></i>Update Vehicle Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/VehicleAssignment/Update.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/VehicleAssignment/Update.js" asp-append-version="true"></script>
}
