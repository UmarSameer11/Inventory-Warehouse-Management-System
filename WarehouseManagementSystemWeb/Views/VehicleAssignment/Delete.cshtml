@model WarehouseManagementSystemWeb.Application.ViewModels.VehicleAssignment.VehicleAssignmentUpdateViewModel

@{
    ViewData["Title"] = "Delete Vehicle Assignment";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Vehicle Assignment</h3>
            <p class="text-muted mb-0">Review the information before permanently deleting this record.</p>
        </div>
        <a asp-controller="VehicleAssignment" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-person-check"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Vehicle Assignment Information</h5>
                    <span class="text-muted small">Verify the record you want to delete.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Are you sure you want to delete this vehicle assignment?</strong>
                    <div class="small mt-1">This action cannot be undone. Please verify the information below before continuing.</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Vehicle Assignment Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Vehicle Assignment ID</label>
                        <div class="detail-value">@Model.VehicleAssignmentId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Vehicle</label>
                        <div class="detail-value">@(Model.Vehicles.FirstOrDefault(x => x.Value == Model.VehicleId.ToString())?.Text ?? ("#" + Model.VehicleId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Employee</label>
                        <div class="detail-value">@(Model.Employees.FirstOrDefault(x => x.Value == Model.EmployeeId.ToString())?.Text ?? ("#" + Model.EmployeeId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Assignment Date</label>
                        <div class="detail-value">@Model.AssignmentDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Return Date</label>
                        <div class="detail-value">@(Model.ReturnDate?.ToString("dd MMM yyyy") ?? "Not provided")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value">@if (Model.IsActive) { <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Active</span> } else { <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span> }</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="VehicleAssignment" asp-action="DeleteConfirmed" method="post" id="deleteVehicleAssignmentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.VehicleAssignmentId" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="VehicleAssignment" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-danger px-4" id="deleteVehicleAssignmentBtn"><i class="bi bi-trash3 me-2"></i>Delete Vehicle Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/VehicleAssignment/Delete.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/VehicleAssignment/Delete.js" asp-append-version="true"></script>
}
