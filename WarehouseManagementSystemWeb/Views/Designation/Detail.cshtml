@model WarehouseManagementSystemWeb.Application.ViewModels.Designation.DesignationUpdateViewModel

@{
ViewData["Title"] = "Designation Details";
}

<div class="container-fluid px-4 py-4">

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>

        <h3 class="fw-bold mb-1">
            Designation Details
        </h3>

        <p class="text-muted mb-0">
            View the designation's information and current status.
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-controller="Designation"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Designations

        </a>


        <a asp-controller="Designation"
           asp-action="Update"
           asp-route-id="@Model.DesignationId"
           class="btn btn-primary px-4">

            <i class="bi bi-pencil-square me-2"></i>
            Edit Designation

        </a>

    </div>

</div>


<!-- Main Card -->
<div class="card border-0 shadow-sm">


    <!-- Card Header -->
    <div class="card-header bg-white border-bottom py-3">

        <div class="d-flex align-items-center gap-3">

            <div class="detail-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>

                <h5 class="fw-semibold mb-1">
                    Designation Information
                </h5>

                <span class="text-muted small">
                    Complete designation information and current status.
                </span>

            </div>

        </div>

    </div>


    <!-- Card Body -->
    <div class="card-body p-4">


        <!-- Designation Information -->
        <div class="form-section">

            <div class="section-heading mb-4">

                <h6 class="fw-bold mb-1">
                    Designation Details
                </h6>

                <p class="text-muted small mb-0">
                    Basic information about the designation.
                </p>

            </div>


            <div class="row g-4">


                <!-- Designation ID -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Designation ID
                    </label>

                    <div class="detail-value">
                        @Model.DesignationId
                    </div>

                </div>


                <!-- Designation Name -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Designation Name
                    </label>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.DesignationName))
                        {
                            <i class="bi bi-person-badge me-2"></i>
                            @Model.DesignationName
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <div class="detail-value">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">
                                <i class="bi bi-x-circle me-1"></i>
                                Inactive
                            </span>
                        }

                    </div>

                </div>


            </div>

        </div>


        <hr class="my-4" />


        <!-- Designation Status Information -->
        <div class="form-section">

            <div class="section-heading mb-4">

                <h6 class="fw-bold mb-1">
                    Designation Status
                </h6>

                <p class="text-muted small mb-0">
                    Current availability of this designation in the system.
                </p>

            </div>


            <div class="row g-4">

                <!-- Current Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Current Status
                    </label>

                    <div class="detail-value">

                        @if (Model.IsActive)
                        {
                            <i class="bi bi-check-circle-fill text-success me-2"></i>

                            <span>
                                Designation is currently active.
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-pause-circle-fill text-secondary me-2"></i>

                            <span>
                                Designation is currently inactive.
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <hr class="my-4" />


        <!-- Actions -->
        <div class="d-flex flex-column flex-sm-row
                    justify-content-end gap-2">


            <a asp-controller="Designation"
               asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back

            </a>


            <a asp-controller="Designation"
               asp-action="Update"
               asp-route-id="@Model.DesignationId"
               class="btn btn-primary px-4">

                <i class="bi bi-pencil-square me-2"></i>
                Edit Designation

            </a>

        </div>

    </div>

</div>

</div>

@section Styles {

<link rel="stylesheet"
      href="~/css/Designation/Detail.css"
      asp-append-version="true" />

}
