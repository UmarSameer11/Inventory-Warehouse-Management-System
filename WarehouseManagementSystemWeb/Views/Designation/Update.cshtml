@model WarehouseManagementSystemWeb.Application.ViewModels.Designation.DesignationUpdateViewModel

@{
ViewData["Title"] = "Update Designation";
}

<div class="container-fluid px-4 py-4">

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>
        <h3 class="fw-bold mb-1">
            Update Designation
        </h3>

        <p class="text-muted mb-0">
            Update designation information and status.
        </p>
    </div>

    <a asp-controller="Designation"
       asp-action="Index"
       class="btn btn-outline-secondary px-4">

        <i class="bi bi-arrow-left me-2"></i>
        Back to Designations

    </a>

</div>


<!-- Main Card -->
<div class="card border-0 shadow-sm">

    <!-- Card Header -->
    <div class="card-header bg-white border-bottom py-3">

        <div class="d-flex align-items-center gap-3">

            <div class="update-icon">
                <i class="bi bi-person-gear"></i>
            </div>

            <div>
                <h5 class="fw-semibold mb-1">
                    Designation Information
                </h5>

                <span class="text-muted small">
                    Modify the designation's information and active status.
                </span>
            </div>

        </div>

    </div>


    <!-- Form -->
    <div class="card-body p-4">

        <form asp-controller="Designation"
              asp-action="Update"
              method="post"
              id="designationUpdateForm">

            @Html.AntiForgeryToken()

            <!-- Hidden ID -->
            <input asp-for="DesignationId"
                   type="hidden" />


            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary"
                 role="alert">
            </div>


            <!-- Designation Information -->
            <div class="form-section">

                <div class="section-heading mb-4">

                    <h6 class="fw-bold mb-1">
                        Designation Details
                    </h6>

                    <p class="text-muted small mb-0">
                        Update the designation name and current status.
                    </p>

                </div>


                <div class="row g-4">

                    <!-- Designation ID -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Designation ID
                        </label>

                        <input asp-for="DesignationId"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- Designation Name -->
                    <div class="col-md-8">

                        <label asp-for="DesignationName"
                               class="form-label fw-semibold">

                            Designation Name
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-person-badge"></i>
                            </span>

                            <input asp-for="DesignationName"
                                   class="form-control"
                                   placeholder="e.g. Software Engineer"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="DesignationName"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <div class="form-check form-switch status-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="IsActive" />

                            <label class="form-check-label"
                                   for="IsActive"
                                   id="statusLabel">

                                Active

                            </label>

                        </div>

                        <small class="text-muted">
                            Enable or disable this designation.
                        </small>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Actions -->
            <div class="d-flex flex-column flex-sm-row
                        justify-content-end gap-2">

                <a asp-controller="Designation"
                   asp-action="Index"
                   class="btn btn-light border px-4">

                    <i class="bi bi-x-lg me-2"></i>
                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-primary px-4"
                        id="updateDesignationBtn">

                    <i class="bi bi-check-lg me-2"></i>
                    Update Designation

                </button>

            </div>

        </form>

    </div>

</div>

</div>

@section Styles {

<link rel="stylesheet"
      href="~/css/Designation/Update.css"
      asp-append-version="true" />

}

@section Scripts {

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script src="~/js/Designation/Update.js"
        asp-append-version="true"></script>

}
