@model IEnumerable<WarehouseManagementSystemWeb.Application.ViewModels.Department.DepartmentListViewModel>

@{
    ViewData["Title"] = "Index";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage"
         data-message="@TempData["SuccessMessage"]">
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorMessage"
         data-message="@TempData["ErrorMessage"]">
    </div>
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Departments
            </h3>

            <p class="text-muted mb-0">
                Manage your organization departments and their status.
            </p>
        </div>

        <a asp-controller="Department"
           asp-action="Create"
           class="btn btn-primary px-4 py-2">

            <i class="bi bi-plus-lg me-2"></i>
            Add Department

        </a>

    </div>


    <!-- Summary Card -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <span class="text-muted small">
                                Total Departments
                            </span>

                            <h3 class="fw-bold mt-2 mb-0">
                                @(Model?.Count() ?? 0)
                            </h3>

                        </div>

                        <div class="department-summary-icon">

                            <i class="bi bi-building fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- Toolbar -->
        <div class="card-body p-4 border-bottom">

            <div class="d-flex flex-column flex-lg-row
                        justify-content-between
                        align-items-lg-center
                        gap-3">

                <div>

                    <h5 class="fw-semibold mb-1">
                        Department Directory
                    </h5>

                    <span class="text-muted small">
                        A complete list of registered departments
                    </span>

                </div>


                <!-- Search -->
                <div class="position-relative department-search">

                    <i class="bi bi-search position-absolute
                              top-50 start-0 translate-middle-y
                              ms-3 text-muted"></i>

                    <input type="text"
                           id="departmentSearch"
                           class="form-control ps-5 py-2"
                           placeholder="Search departments..." />

                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="departmentTable">

                <thead class="bg-light">

                    <tr>

                        <th class="ps-4 text-muted small fw-semibold">
                            DEPARTMENT
                        </th>

                        <th class="text-muted small fw-semibold">
                            ID
                        </th>

                        <th class="text-muted small fw-semibold">
                            STATUS
                        </th>

                        <th class="text-end pe-4 text-muted small fw-semibold">
                            ACTIONS
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var department in Model)
                        {
                            <tr>

                                <!-- Department -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="department-avatar">

                                            <i class="bi bi-building"></i>

                                        </div>

                                        <div>

                                            <div class="fw-semibold text-dark">
                                                @department.DepartmentName
                                            </div>

                                            <div class="text-muted small">
                                                Department
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- ID -->
                                <td>

                                    <span class="department-code">
                                        #@department.DepartmentId
                                    </span>

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (department.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <!-- Details -->
                                        <a asp-controller="Department"
                                           asp-action="Detail"
                                           asp-route-id="@department.DepartmentId"
                                           class="btn btn-sm btn-light action-btn"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-controller="Department"
                                           asp-action="Update"
                                           asp-route-id="@department.DepartmentId"
                                           class="btn btn-sm btn-light action-btn"
                                           title="Update">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <a asp-controller="Department"
                                           asp-action="Delete"
                                           asp-route-id="@department.DepartmentId"
                                           class="btn btn-sm btn-light action-btn delete-btn"
                                           title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <tr>

                            <td colspan="4">

                                <div class="text-center py-5">

                                    <div class="empty-icon mx-auto mb-3">

                                        <i class="bi bi-building"></i>

                                    </div>

                                    <h5 class="fw-semibold">
                                        No departments found
                                    </h5>

                                    <p class="text-muted mb-3">
                                        There are currently no departments available.
                                    </p>

                                    <a asp-controller="Department"
                                       asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-2"></i>
                                        Add Department

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/Department/Index.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="~/js/Department/Index.js"
            asp-append-version="true"></script>
}