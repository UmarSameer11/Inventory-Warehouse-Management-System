@model WarehouseManagementSystemWeb.Application.ViewModels.Department.DepartmentUpdateViewModel

@{
ViewData["Title"] = "Department Details";
}

<div class="container-fluid px-4 py-4">

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>

        <h3 class="fw-bold mb-1">
            Department Details
        </h3>

        <p class="text-muted mb-0">
            View the department's information and current status.
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-controller="Department"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Departments

        </a>


        <a asp-controller="Department"
           asp-action="Update"
           asp-route-id="@Model.DepartmentId"
           class="btn btn-primary px-4">

            <i class="bi bi-pencil-square me-2"></i>
            Edit Department

        </a>

    </div>

</div>


<!-- Main Card -->
<div class="card border-0 shadow-sm">


    <!-- Card Header -->
    <div class="card-header bg-white border-bottom py-3">

        <div class="d-flex align-items-center gap-3">

            <div class="detail-icon">
                <i class="bi bi-building-check"></i>
            </div>

            <div>

                <h5 class="fw-semibold mb-1">
                    Department Information
                </h5>

                <span class="text-muted small">
                    Complete department information and current status.
                </span>

            </div>

        </div>

    </div>


    <!-- Card Body -->
    <div class="card-body p-4">


        <!-- Department Information -->
        <div class="form-section">

            <div class="section-heading mb-4">

                <h6 class="fw-bold mb-1">
                    Department Details
                </h6>

                <p class="text-muted small mb-0">
                    Basic information about the department.
                </p>

            </div>


            <div class="row g-4">


                <!-- Department ID -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Department ID
                    </label>

                    <div class="detail-value">
                        @Model.DepartmentId
                    </div>

                </div>


                <!-- Department Name -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Department Name
                    </label>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.DepartmentName))
                        {
                            <i class="bi bi-building me-2"></i>
                            @Model.DepartmentName
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <div class="detail-value">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">
                                <i class="bi bi-x-circle me-1"></i>
                                Inactive
                            </span>
                        }

                    </div>

                </div>


            </div>

        </div>


        <hr class="my-4" />


        <!-- Department Status Information -->
        <div class="form-section">

            <div class="section-heading mb-4">

                <h6 class="fw-bold mb-1">
                    Department Status
                </h6>

                <p class="text-muted small mb-0">
                    Current availability of this department in the system.
                </p>

            </div>


            <div class="row g-4">

                <!-- Current Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Current Status
                    </label>

                    <div class="detail-value">

                        @if (Model.IsActive)
                        {
                            <i class="bi bi-check-circle-fill text-success me-2"></i>

                            <span>
                                Department is currently active.
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-pause-circle-fill text-secondary me-2"></i>

                            <span>
                                Department is currently inactive.
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <hr class="my-4" />


        <!-- Actions -->
        <div class="d-flex flex-column flex-sm-row
                    justify-content-end gap-2">


            <a asp-controller="Department"
               asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back

            </a>


            <a asp-controller="Department"
               asp-action="Update"
               asp-route-id="@Model.DepartmentId"
               class="btn btn-primary px-4">

                <i class="bi bi-pencil-square me-2"></i>
                Edit Department

            </a>

        </div>

    </div>

</div>

</div>

@section Styles {

<link rel="stylesheet"
      href="~/css/Department/Detail.css"
      asp-append-version="true" />

}

@section Scripts {

<script src="~/js/Department/Detail.js"
        asp-append-version="true"></script>

}
