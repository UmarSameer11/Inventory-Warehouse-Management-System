@model WarehouseManagementSystemWeb.Application.ViewModels.Department.DepartmentUpdateViewModel

@{
ViewData["Title"] = "Delete Department";
}

<div class="container-fluid px-4 py-4">

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

    <div>

        <h3 class="fw-bold mb-1">
            Delete Department
        </h3>

        <p class="text-muted mb-0">
            Review the department information before permanently deleting this record.
        </p>

    </div>


    <a asp-controller="Department"
       asp-action="Index"
       class="btn btn-outline-secondary px-4">

        <i class="bi bi-arrow-left me-2"></i>
        Back to Departments

    </a>

</div>


<!-- Main Card -->
<div class="card border-0 shadow-sm">


    <!-- Card Header -->
    <div class="card-header bg-white border-bottom py-3">

        <div class="d-flex align-items-center gap-3">

            <div class="delete-icon">
                <i class="bi bi-building-x"></i>
            </div>

            <div>

                <h5 class="fw-semibold mb-1">
                    Department Information
                </h5>

                <span class="text-muted small">
                    Verify the department you want to delete.
                </span>

            </div>

        </div>

    </div>


    <!-- Card Body -->
    <div class="card-body p-4">


        <!-- Warning -->
        <div class="alert alert-warning d-flex align-items-start gap-3"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill fs-5"></i>

            <div>

                <strong>
                    Are you sure you want to delete this department?
                </strong>

                <div class="small mt-1">
                    This action may remove the department record from the system.
                    Please verify the information below before continuing.
                </div>

            </div>

        </div>


        <!-- Department Information -->
        <div class="form-section mt-4">

            <div class="section-heading mb-4">

                <h6 class="fw-bold mb-1">
                    Department Details
                </h6>

                <p class="text-muted small mb-0">
                    Basic information about the department.
                </p>

            </div>


            <div class="row g-4">


                <!-- Department ID -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Department ID
                    </label>

                    <div class="detail-value">
                        @Model.DepartmentId
                    </div>

                </div>


                <!-- Department Name -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Department Name
                    </label>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.DepartmentName)
                            ? "Not provided"
                            : Model.DepartmentName)
                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <div class="detail-value">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">
                                <i class="bi bi-x-circle me-1"></i>
                                Inactive
                            </span>
                        }

                    </div>

                </div>


            </div>

        </div>


        <hr class="my-4" />


        <!-- Delete Form -->
        <form asp-controller="Department"
              asp-action="DeleteConfirmed"
              method="post"
              id="deleteDepartmentForm">

            @Html.AntiForgeryToken()

                   <input type="hidden"
               name="id"
               value="@Model.DepartmentId" />


            <!-- Actions -->
            <div class="d-flex flex-column flex-sm-row
                        justify-content-end gap-2">


                <!-- Cancel -->
                <a asp-controller="Department"
                   asp-action="Index"
                   class="btn btn-light border px-4">

                    <i class="bi bi-x-lg me-2"></i>
                    Cancel

                </a>


                <!-- Delete -->
                <button type="submit"
                        class="btn btn-danger px-4"
                        id="deleteDepartmentBtn">

                    <i class="bi bi-trash3 me-2"></i>
                    Delete Department

                </button>

            </div>

        </form>

    </div>

</div>

</div>

@section Styles {

<link rel="stylesheet"
      href="~/css/Department/Delete.css"
      asp-append-version="true" />


}

@section Scripts {

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script src="~/js/Department/Delete.js"
        asp-append-version="true"></script>

}
