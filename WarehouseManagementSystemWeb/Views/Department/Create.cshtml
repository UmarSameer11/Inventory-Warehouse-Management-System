@model WarehouseManagementSystemWeb.Application.ViewModels.Department.DepartmentCreateViewModel

@{
    ViewData["Title"] = "Create Department";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Create Department
            </h3>

            <p class="text-muted mb-0">
                Add a new department to the organization.
            </p>
        </div>

        <a asp-controller="Department"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Departments

        </a>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="create-icon">
                    <i class="bi bi-building-add"></i>
                </div>

                <div>
                    <h5 class="fw-semibold mb-1">
                        Department Information
                    </h5>

                    <span class="text-muted small">
                        Enter the basic information for the new department.
                    </span>
                </div>

            </div>

        </div>


        <!-- Form -->
        <div class="card-body p-4">

            <form asp-controller="Department"
                  asp-action="Create"
                  method="post"
                  id="departmentCreateForm">

                @Html.AntiForgeryToken()


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary"
                     role="alert">
                </div>


                <!-- Department Information -->
                <div class="form-section">

                    <div class="section-heading mb-4">

                        <h6 class="fw-bold mb-1">
                            Department Details
                        </h6>

                        <p class="text-muted small mb-0">
                            Provide the department name and active status.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Department Name -->
                        <div class="col-md-8">

                            <label asp-for="DepartmentName"
                                   class="form-label fw-semibold">

                                Department Name
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>

                                <input asp-for="DepartmentName"
                                       class="form-control"
                                       placeholder="e.g. Human Resources"
                                       autocomplete="off" />

                            </div>

                            <span asp-validation-for="DepartmentName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Is Active -->
                        <div class="col-md-4">

                            <label class="form-label fw-semibold">
                                Status
                            </label>

                            <div class="form-check form-switch status-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch"
                                       id="IsActive" />

                                <label class="form-check-label"
                                       for="IsActive"
                                       id="statusLabel">

                                    Active

                                </label>

                            </div>

                            <small class="text-muted">
                                Enable this department for active use.
                            </small>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Actions -->
                <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-light border px-4">

                        <i class="bi bi-x-lg me-2"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="createDepartmentBtn">

                        <i class="bi bi-check-lg me-2"></i>
                        Create Department

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/Department/Create.css"
          asp-append-version="true" />

}


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Department/Create.js"
            asp-append-version="true"></script>

}