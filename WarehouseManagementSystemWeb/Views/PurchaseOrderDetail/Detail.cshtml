@model WarehouseManagementSystemWeb.Application.ViewModels.PurchaseOrderDetail.PurchaseOrderDetailUpdateViewModel

@{
    ViewData["Title"] = "Purchase Order Detail Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Purchase Order Detail Details</h3>
            <p class="text-muted mb-0">View complete purchase order detail information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="PurchaseOrderDetail" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="PurchaseOrderDetail" asp-action="Update" asp-route-id="@Model.PurchaseOrderDetailId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-list-check"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Purchase Order Detail Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Line Item Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Order Detail ID</label>
                        <div class="detail-value">@Model.PurchaseOrderDetailId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Order</label>
                        <div class="detail-value">@(Model.PurchaseOrders.FirstOrDefault(x => x.Value == Model.PurchaseOrderId.ToString())?.Text ?? ("#" + Model.PurchaseOrderId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@(Model.Products.FirstOrDefault(x => x.Value == Model.ProductId.ToString())?.Text ?? ("#" + Model.ProductId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Quantity</label>
                        <div class="detail-value">@Model.Quantity.ToString("N2")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit Price</label>
                        <div class="detail-value">@Model.UnitPrice.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="PurchaseOrderDetail" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="PurchaseOrderDetail" asp-action="Update" asp-route-id="@Model.PurchaseOrderDetailId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Purchase Order Detail</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/PurchaseOrderDetail/Detail.css" asp-append-version="true" /> }
