@model WarehouseManagementSystemWeb.Application.ViewModels.PurchaseOrderDetail.PurchaseOrderDetailUpdateViewModel

@{
    ViewData["Title"] = "Delete Purchase Order Detail";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Purchase Order Detail</h3>
            <p class="text-muted mb-0">Review the information before permanently deleting this record.</p>
        </div>
        <a asp-controller="PurchaseOrderDetail" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-list-check"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Purchase Order Detail Information</h5>
                    <span class="text-muted small">Verify the record you want to delete.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Are you sure you want to delete this purchase order detail?</strong>
                    <div class="small mt-1">This action cannot be undone. Please verify the information below before continuing.</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Line Item Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Order Detail ID</label>
                        <div class="detail-value">@Model.PurchaseOrderDetailId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Order</label>
                        <div class="detail-value">@(Model.PurchaseOrders.FirstOrDefault(x => x.Value == Model.PurchaseOrderId.ToString())?.Text ?? ("#" + Model.PurchaseOrderId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@(Model.Products.FirstOrDefault(x => x.Value == Model.ProductId.ToString())?.Text ?? ("#" + Model.ProductId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Quantity</label>
                        <div class="detail-value">@Model.Quantity.ToString("N2")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unit Price</label>
                        <div class="detail-value">@Model.UnitPrice.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="PurchaseOrderDetail" asp-action="DeleteConfirmed" method="post" id="deletePurchaseOrderDetailForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.PurchaseOrderDetailId" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="PurchaseOrderDetail" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-danger px-4" id="deletePurchaseOrderDetailBtn"><i class="bi bi-trash3 me-2"></i>Delete Purchase Order Detail</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/PurchaseOrderDetail/Delete.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/PurchaseOrderDetail/Delete.js" asp-append-version="true"></script>
}
