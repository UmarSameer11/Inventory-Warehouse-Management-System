@model WarehouseManagementSystemWeb.Application.ViewModels.Supplier.SupplierCreateViewModel

@{
    ViewData["Title"] = "Create Supplier";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Create Supplier</h3>
            <p class="text-muted mb-0">Add a new supplier to the system.</p>
        </div>
        <a asp-controller="Supplier" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="create-icon"><i class="bi bi-truck"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Supplier Information</h5>
                    <span class="text-muted small">Enter the information for the new supplier.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="Supplier" asp-action="Create" method="post" id="supplierCreateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Supplier Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="SupplierCode" class="form-label fw-semibold">Supplier Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input asp-for="SupplierCode" type="text" class="form-control" placeholder="e.g. SUP-001" autocomplete="off" />
                            </div>
                            <span asp-validation-for="SupplierCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SupplierName" class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input asp-for="SupplierName" type="text" class="form-control" placeholder="Enter supplier name" autocomplete="off" />
                            </div>
                            <span asp-validation-for="SupplierName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactPerson" class="form-label fw-semibold">Contact Person</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="ContactPerson" type="text" class="form-control" placeholder="Enter contact person (optional)" autocomplete="off" />
                            </div>
                            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" type="tel" class="form-control" placeholder="Enter phone (optional)" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter email (optional)" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="Address" class="form-control" rows="3" placeholder="Street, area ..."></textarea>
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <div class="form-check form-switch status-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActive" />
                                <label class="form-check-label" for="IsActive" id="statusLabel">Active</label>
                            </div>
                            <small class="text-muted">Enable or disable this record.</small>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="Supplier" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="createSupplierBtn"><i class="bi bi-check-lg me-2"></i>Create Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/Supplier/Create.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/Supplier/Create.js" asp-append-version="true"></script>
}
