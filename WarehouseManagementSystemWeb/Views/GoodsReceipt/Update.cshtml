
@model WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt.GoodsReceiptDetailViewModel

@{
    ViewData["Title"] = "Update Goods Receipt";
}

<div class="container-fluid px-4 py-4 grn-update-page">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Update Goods Receipt</h3>
            <p class="text-muted mb-0">Update GRN header and received product details.</p>
        </div>

        <a asp-controller="GoodsReceipt" asp-action="Index"
           class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>

    <form asp-controller="GoodsReceipt"
          asp-action="Update"
          asp-route-id="@Model.GoodsReceiptId"
          method="post"
          id="goodsReceiptUpdateForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="GoodsReceiptId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <!-- HEADER INFORMATION -->
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="grn-section-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <div>
                        <h5 class="fw-semibold mb-0">Goods Receipt Information</h5>
                        <small class="text-muted">GRN header information</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">

                <div class="row g-4">

                    <!-- GRN Number -->
                    <div class="col-md-6">
                        <label asp-for="GoodsReceiptNumber" class="form-label fw-semibold">
                            Goods Receipt Number
                        </label>
                        <input asp-for="GoodsReceiptNumber"
                               class="form-control readonly-field"
                               readonly />
                    </div>

                    <!-- Purchase Order -->
                    <div class="col-md-6">
                        <label asp-for="PurchaseOrderId" class="form-label fw-semibold">
                            Purchase Order <span class="text-danger">*</span>
                        </label>

                        <select asp-for="PurchaseOrderId"
                                asp-items="Model.PurchaseOrders"
                                class="form-select">
                            <option value="">-- Select Purchase Order --</option>
                        </select>

                        <span asp-validation-for="PurchaseOrderId"
                              class="text-danger small"></span>
                    </div>

                    <!-- Warehouse -->
                    <div class="col-md-6">
                        <label asp-for="WarehouseId" class="form-label fw-semibold">
                            Warehouse <span class="text-danger">*</span>
                        </label>

                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select">
                            <option value="">-- Select Warehouse --</option>
                        </select>

                        <span asp-validation-for="WarehouseId"
                              class="text-danger small"></span>
                    </div>

                    <!-- Received By -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Received By</label>
                        <input asp-for="ReceivedByEmployeeName"
                               class="form-control readonly-field"
                               readonly />
                    </div>

                    <!-- Receipt Date -->
                    <div class="col-md-6">
                        <label asp-for="ReceiptDate" class="form-label fw-semibold">
                            Receipt Date <span class="text-danger">*</span>
                        </label>

                        <input asp-for="ReceiptDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ReceiptDate"
                              class="text-danger small"></span>
                    </div>

                    <!-- Supplier Invoice -->
                    <div class="col-md-6">
                        <label asp-for="SupplierInvoiceNumber"
                               class="form-label fw-semibold">
                            Supplier Invoice Number
                        </label>

                        <input asp-for="SupplierInvoiceNumber"
                               class="form-control"
                               placeholder="Enter supplier invoice number" />

                        <span asp-validation-for="SupplierInvoiceNumber"
                              class="text-danger small"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger small"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-md-6">
                        <label asp-for="Remarks" class="form-label fw-semibold">
                            Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter remarks"></textarea>
                    </div>

                </div>
            </div>
        </div>

        <!-- PRODUCT DETAILS -->
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="grn-section-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <h5 class="fw-semibold mb-0">Goods Receipt Products</h5>
                        <small class="text-muted">
                            Review and update received quantities
                        </small>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0"
                           id="grnDetailsTable">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">PRODUCT</th>
                                <th>BATCH NUMBER</th>
                                <th class="text-end">ORDERED QTY</th>
                                <th class="text-end">RECEIVED QTY</th>
                                <th class="text-end">UNIT PRICE</th>
                                <th class="text-end pe-4">TOTAL</th>
                            </tr>
                        </thead>

                        <tbody id="grnProductRows">

                            @for (int i = 0; i < Model.Details.Count; i++)
                            {
                                <tr class="grn-product-row">

                                    <td class="ps-4">
                                        <input type="hidden"
                                               asp-for="Details[i].PurchaseOrderDetailId" />

                                        <input type="hidden"
                                               asp-for="Details[i].ProductId" />

                                        <input type="hidden"
                                               asp-for="Details[i].BatchId" />

                                        <div class="fw-semibold">
                                            @Model.Details[i].ProductName
                                        </div>
                                    </td>

                                    <td>
                                        <span class="batch-badge">
                                            @Model.Details[i].BatchNumber
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        @Model.Details[i].OrderedQuantity.ToString("N3")
                                    </td>

                                    <td>
                                        <input asp-for="Details[i].QuantityReceived"
                                               type="number"
                                               min="0"
                                               step="0.001"
                                               class="form-control text-end received-quantity"
                                               required />
                                        <span asp-validation-for="Details[i].QuantityReceived"
                                              class="text-danger small"></span>
                                    </td>

                                    <td class="text-end">
                                        <input type="hidden"
                                               asp-for="Details[i].UnitPrice" />

                                        @Model.Details[i].UnitPrice.ToString("N2")
                                    </td>

                                    <td class="text-end pe-4 fw-semibold row-total">
                                        @Model.Details[i].TotalAmount.ToString("N2")
                                    </td>

                                </tr>
                            }

                            @if (Model.Details.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No product details available.
                                    </td>
                                </tr>
                            }

                        </tbody>

                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-bold">
                                    GRAND TOTAL
                                </td>
                                <td class="text-end pe-4 fw-bold text-primary">
                                    <span id="grnGrandTotal">0.00</span>
                                </td>
                            </tr>
                        </tfoot>

                    </table>
                </div>

            </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">

            <a asp-controller="GoodsReceipt"
               asp-action="Index"
               class="btn btn-light border px-4">
                <i class="bi bi-x-lg me-2"></i>Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary px-4"
                    id="updateGoodsReceiptBtn">
                <i class="bi bi-check-lg me-2"></i>
                Update Goods Receipt
            </button>

        </div>

    </form>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/GoodsReceipt/Update.css"
          asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/GoodsReceipt/Update.js"
            asp-append-version="true"></script>
}
