@using WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt
@model GoodsReceiptCreateViewModel

@{
    ViewData["Title"] = "Create Goods Receipt";
}

<link rel="stylesheet"
      href="~/css/goods-receipt-create.css"
      asp-append-version="true" />

<div class="grn-page">
    <div class="grn-heading">
        <div>
            <span class="grn-eyebrow">INVENTORY MANAGEMENT</span>
            <h2>Create Goods Receipt</h2>
            <p>Receive products against a purchase order and record their quantities.</p>
        </div>

        <a asp-controller="GoodsReceipt"
           asp-action="Index"
           class="grn-back-btn">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <form asp-controller="GoodsReceipt"
          asp-action="Create"
          method="post"
          id="goodsReceiptForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger validation-summary"></div>

        <!-- GRN HEADER -->
        <section class="grn-card">
            <div class="grn-card-header">
                <div class="grn-section-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h5>Goods Receipt Information</h5>
                    <p>Enter the general details of this receipt.</p>
                </div>
            </div>

            <div class="grn-card-body">
                <div class="row g-3">

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="ReceiptNumber" class="form-label">
                            Receipt Number <span class="required">*</span>
                        </label>
                        <input asp-for="ReceiptNumber"
                               class="form-control"
                               placeholder="e.g. GRN-2026-001" />
                        <span asp-validation-for="ReceiptNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="PurchaseOrderId" class="form-label">
                            Purchase Order <span class="required">*</span>
                        </label>
                        <select asp-for="PurchaseOrderId"
                                asp-items="Model.PurchaseOrders"
                                class="form-select">
                            <option value="">-- Select Purchase Order --</option>
                        </select>
                        <span asp-validation-for="PurchaseOrderId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="WarehouseId" class="form-label">
                            Warehouse <span class="required">*</span>
                        </label>
                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select">
                            <option value="">-- Select Warehouse --</option>
                        </select>
                        <span asp-validation-for="WarehouseId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="ReceiptDate" class="form-label">
                            Receipt Date <span class="required">*</span>
                        </label>
                        <input asp-for="ReceiptDate"
                               type="date"
                               class="form-control"
                               value="@Model.ReceiptDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ReceiptDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="ReceivedByEmployeeId" class="form-label">
                            Received By (Employee ID) <span class="required">*</span>
                        </label>
                        <input asp-for="ReceivedByEmployeeId"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter employee ID" />
                        <span asp-validation-for="ReceivedByEmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Status" class="form-label">
                            Status
                        </label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </section>

        <!-- PRODUCT DETAILS -->
        <section class="grn-card">
            <div class="grn-card-header grn-details-header">
                <div class="grn-title-group">
                    <div class="grn-section-icon product-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <h5>Received Products</h5>
                        <p>Add one or more products to this goods receipt.</p>
                    </div>
                </div>

                <button type="button"
                        id="addProductBtn"
                        class="grn-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Product
                </button>
            </div>

            <div class="grn-card-body">
                <div class="grn-table-wrapper">
                    <table class="table grn-table">
                        <thead>
                            <tr>
                                <th style="min-width: 220px;">Product</th>
                                <th style="min-width: 170px;">Batch (Optional)</th>
                                <th style="min-width: 140px;">Quantity</th>
                                <th style="min-width: 150px;">Unit Price</th>
                                <th style="min-width: 130px;">Line Total</th>
                                <th class="text-center" style="width: 75px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="productRows">
                            @for (var i = 0; i < Model.Details.Count; i++)
                            {
                                <tr class="product-row">
                                    <td>
                                        <select name="Details[@i].ProductId"
                                                id="Details_@(i)__ProductId"
                                                class="form-select product-select"
                                                required>
                                            <option value="">-- Select Product --</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Value"
                                                        selected="@(product.Value == Model.Details[i].ProductId.ToString())">
                                                    @product.Text
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <select name="Details[@i].BatchId"
                                                id="Details_@(i)__BatchId"
                                                class="form-select">
                                            <option value="">No batch selected</option>
                                            @foreach (var batch in Model.Batches)
                                            {
                                                <option value="@batch.Value"
                                                        selected="@(Model.Details[i].BatchId.HasValue && batch.Value == Model.Details[i].BatchId.Value.ToString())">
                                                    @batch.Text
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input name="Details[@i].Quantity"
                                               id="Details_@(i)__Quantity"
                                               type="number"
                                               min="0.001"
                                               step="0.001"
                                               value="@(Model.Details[i].Quantity > 0 ? Model.Details[i].Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                               class="form-control quantity-input"
                                               placeholder="0.000"
                                               required />
                                    </td>

                                    <td>
                                        <input name="Details[@i].UnitPrice"
                                               id="Details_@(i)__UnitPrice"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               value="@(Model.Details[i].UnitPrice > 0 ? Model.Details[i].UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                               class="form-control price-input"
                                               placeholder="0.00"
                                               required />
                                    </td>

                                    <td>
                                        <span class="line-total">0.00</span>
                                    </td>

                                    <td class="text-center">
                                        <button type="button"
                                                class="grn-remove-btn remove-product-btn"
                                                title="Remove product"
                                                aria-label="Remove product">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="grn-table-hint">
                    <i class="bi bi-info-circle"></i>
                    Add a separate row for each product you receive.
                </div>

                <div class="grn-total-panel">
                    <div>
                        <span class="grn-total-label">Total Products</span>
                        <strong id="totalProducts">0</strong>
                    </div>
                    <div class="grn-grand-total">
                        <span class="grn-total-label">Estimated Total</span>
                        <strong id="grandTotal">0.00</strong>
                    </div>
                </div>
            </div>
        </section>

        <!-- FORM ACTIONS -->
        <div class="grn-form-actions">
            <a asp-controller="GoodsReceipt"
               asp-action="Index"
               class="grn-cancel-btn">
                Cancel
            </a>

            <button type="submit" id="saveGrnBtn" class="grn-save-btn">
                <i class="bi bi-check2-circle"></i>
                Save Goods Receipt
            </button>
        </div>
    </form>
</div>

<!-- Template for dynamically added product rows -->
<template id="productRowTemplate">
    <tr class="product-row">
        <td>
            <select name="Details[__index__].ProductId"
                    id="Details___index____ProductId"
                    class="form-select product-select"
                    required>
                <option value="">-- Select Product --</option>
                @foreach (var product in Model.Products)
                {
                    <option value="@product.Value">@product.Text</option>
                }
            </select>
        </td>

        <td>
            <select name="Details[__index__].BatchId"
                    id="Details___index____BatchId"
                    class="form-select">
                <option value="">No batch selected</option>
                @foreach (var batch in Model.Batches)
                {
                    <option value="@batch.Value">@batch.Text</option>
                }
            </select>
        </td>

        <td>
            <input name="Details[__index__].Quantity"
                   id="Details___index____Quantity"
                   type="number"
                   min="0.001"
                   step="0.001"
                   class="form-control quantity-input"
                   placeholder="0.000"
                   required />
        </td>

        <td>
            <input name="Details[__index__].UnitPrice"
                   id="Details___index____UnitPrice"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control price-input"
                   placeholder="0.00"
                   required />
        </td>

        <td>
            <span class="line-total">0.00</span>
        </td>

        <td class="text-center">
            <button type="button"
                    class="grn-remove-btn remove-product-btn"
                    title="Remove product"
                    aria-label="Remove product">
                <i class="bi bi-trash3"></i>
            </button>
        </td>
    </tr>
</template>


@section Styles { <link rel="stylesheet" href="~/css/GoodsReceipt/Create.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/GoodsReceipt/Create.js" asp-append-version="true"></script>
}



