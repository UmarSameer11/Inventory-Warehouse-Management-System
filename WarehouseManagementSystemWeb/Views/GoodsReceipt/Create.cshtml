
@using System.Globalization
@using WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt

@model GoodsReceiptCreateViewModel

@{
    ViewData["Title"] = "Create Goods Receipt";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/GoodsReceipt/Create.css"
          asp-append-version="true" />
}

<div class="grn-page">

    <!-- PAGE HEADER -->
    <div class="grn-heading">
        <div>
            <span class="grn-eyebrow">INVENTORY MANAGEMENT</span>
            <h2>Create Goods Receipt</h2>
            <p>
                Receive products against a purchase order.
                Remaining quantities can be received in future GRNs.
            </p>
        </div>

        <a asp-controller="GoodsReceipt"
           asp-action="Index"
           class="grn-back-btn">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <form asp-controller="GoodsReceipt"
          asp-action="Create"
          method="post"
          id="goodsReceiptForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger validation-summary"></div>

        <!-- GRN HEADER -->
        <section class="grn-card">

            <div class="grn-card-header">
                <div class="grn-section-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <h5>Goods Receipt Information</h5>
                    <p>Enter receipt and purchase order details.</p>
                </div>
            </div>

            <div class="grn-card-body">
                <div class="row g-3">

                    <!-- RECEIPT NUMBER -->
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="GoodsReceiptNumber"
                               class="form-label">
                            Goods Receipt Number <span class="required">*</span>
                        </label>

                        <input asp-for="GoodsReceiptNumber"
                               class="form-control"
                               placeholder="e.g. GRN-2026-001"
                               required />

                        <span asp-validation-for="GoodsReceiptNumber"
                              class="text-danger"></span>
                    </div>

                    <!-- PURCHASE ORDER NUMBER -->
                    <div class="col-md-6 col-lg-4">
                        <label for="PurchaseOrderNumber"
                               class="form-label">
                            Purchase Order Number
                            <span class="required">*</span>
                        </label>

                        <input type="text"
                               id="PurchaseOrderNumber"
                               class="form-control"
                               placeholder="Enter PO number and press Enter"
                               autocomplete="off"
                               required />

                        <!-- Actual database PO ID will be submitted -->
                        <input type="hidden"
                               asp-for="PurchaseOrderId"
                               id="PurchaseOrderId" />

                        <div id="poLoading"
                             class="small text-muted mt-2 d-none">
                            <span class="spinner-border spinner-border-sm"
                                  role="status"></span>
                            Loading purchase order products...
                        </div>

                        <div id="poMessage"
                             class="small mt-2"
                             role="status"
                             aria-live="polite"></div>

                        <span asp-validation-for="PurchaseOrderId"
                              class="text-danger"></span>
                    </div>

                    <!-- WAREHOUSE -->
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="WarehouseId"
                               class="form-label">
                            Warehouse <span class="required">*</span>
                        </label>

                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select"
                                required>
                            <option value="">-- Select Warehouse --</option>
                        </select>

                        <span asp-validation-for="WarehouseId"
                              class="text-danger"></span>
                    </div>

                    <!-- RECEIPT DATE -->
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="ReceiptDate"
                               class="form-label">
                            Receipt Date <span class="required">*</span>
                        </label>

                        <input asp-for="ReceiptDate"
                               type="date"
                               class="form-control"
                               value="@Model.ReceiptDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               required />

                        <span asp-validation-for="ReceiptDate"
                              class="text-danger"></span>
                    </div>

                    <!-- RECEIVED BY -->
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="ReceivedByEmployeeId"
                               class="form-label">
                            Received By (Employee ID)
                            <span class="required">*</span>
                        </label>

                        <input asp-for="ReceivedByEmployeeId"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter employee ID"
                               required />

                        <span asp-validation-for="ReceivedByEmployeeId"
                              class="text-danger"></span>
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-6 col-lg-4">
                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </section>

        <!-- PRODUCT DETAILS -->
        <section class="grn-card">

            <div class="grn-card-header">
                <div class="grn-title-group">
                    <div class="grn-section-icon product-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <div>
                        <h5>Purchase Order Products</h5>
                        <p>
                            Products will load automatically when you
                            enter a PO number and press Enter.
                        </p>
                    </div>
                </div>
            </div>

            <div class="grn-card-body">

                <div class="grn-table-wrapper">
                    <table class="table grn-table align-middle">

                        <thead>
                            <tr>
                                <th style="min-width:210px;">Product</th>
                                <th style="min-width:110px;">Ordered Qty</th>
                                <th style="min-width:145px;">
                                    Previously Received
                                </th>
                                <th style="min-width:120px;">
                                    Remaining Qty
                                </th>
                                <th style="min-width:145px;">
                                    Receiving Now
                                </th>
                                <th style="min-width:160px;">Batch</th>
                                <th style="min-width:125px;">Unit Price</th>
                                <th style="min-width:120px;">Line Total</th>
                            </tr>
                        </thead>

                        <tbody id="productRows">
                            <tr id="emptyProductsRow">
                                <td colspan="8"
                                    class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
                                    Enter a PO number to load products.
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>

                <div class="grn-table-hint mt-3">
                    <i class="bi bi-info-circle"></i>
                    Enter only the quantity physically received.
                    Unreceived quantities remain available for future GRNs.
                </div>

                <!-- TOTALS -->
                <div class="grn-total-panel mt-4">

                    <div>
                        <span class="grn-total-label">
                            Products Being Received
                        </span>
                        <strong id="totalProducts">0</strong>
                    </div>

                    <div>
                        <span class="grn-total-label">
                            Total Quantity
                        </span>
                        <strong id="totalQuantity">0.000</strong>
                    </div>

                    <div class="grn-grand-total">
                        <span class="grn-total-label">
                            Estimated Total
                        </span>
                        <strong id="grandTotal">0.00</strong>
                    </div>

                </div>

            </div>
        </section>

        <!-- FORM ACTIONS -->
        <div class="grn-form-actions">

            <a asp-controller="GoodsReceipt"
               asp-action="Index"
               class="grn-cancel-btn">
                Cancel
            </a>

            <button type="submit"
                    id="saveGrnBtn"
                    class="grn-save-btn">
                <i class="bi bi-check2-circle"></i>
                Save Goods Receipt
            </button>

        </div>

    </form>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/GoodsReceipt/Create.js"
            asp-append-version="true"></script>
}
