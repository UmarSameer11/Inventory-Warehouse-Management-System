@model WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt.GoodsReceiptCreateViewModel

@{
    ViewData["Title"] = "Create Goods Receipt";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Create Goods Receipt</h3>
            <p class="text-muted mb-0">Add a new goods receipt to the system.</p>
        </div>
        <a asp-controller="GoodsReceipt" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="create-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Goods Receipt Information</h5>
                    <span class="text-muted small">Enter the information for the new goods receipt.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="GoodsReceipt" asp-action="Create" method="post" id="goodsReceiptCreateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Goods Receipt Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="ReceiptNumber" class="form-label fw-semibold">Receipt Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="ReceiptNumber" type="text" class="form-control" placeholder="Enter receipt number" autocomplete="off" />
                            </div>
                            <span asp-validation-for="ReceiptNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchaseOrderId" class="form-label fw-semibold">Purchase Order <span class="text-danger">*</span></label>
                            <select asp-for="PurchaseOrderId" asp-items="Model.PurchaseOrders" class="form-select">
                                <option value="">-- Select Purchase Order --</option>
                            </select>
                            <span asp-validation-for="PurchaseOrderId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarehouseId" class="form-label fw-semibold">Warehouse <span class="text-danger">*</span></label>
                            <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
                                <option value="">-- Select Warehouse --</option>
                            </select>
                            <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReceiptDate" class="form-label fw-semibold">Receipt Date <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="ReceiptDate" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="ReceiptDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-flag"></i></span>
                                <input asp-for="Status" type="text" class="form-control" placeholder="e.g. Pending" autocomplete="off" list="statusOptions" />
                                <datalist id="statusOptions"><option value="Pending"></option><option value="Approved"></option><option value="Completed"></option><option value="Cancelled"></option></datalist>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="GoodsReceipt" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="createGoodsReceiptBtn"><i class="bi bi-check-lg me-2"></i>Create Goods Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/GoodsReceipt/Create.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/GoodsReceipt/Create.js" asp-append-version="true"></script>
}
