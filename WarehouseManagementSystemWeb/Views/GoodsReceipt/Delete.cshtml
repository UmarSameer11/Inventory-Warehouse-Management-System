@model WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt.GoodsReceiptUpdateViewModel

@{
    ViewData["Title"] = "Delete Goods Receipt";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Goods Receipt</h3>
            <p class="text-muted mb-0">Review the information before permanently deleting this record.</p>
        </div>
        <a asp-controller="GoodsReceipt" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Goods Receipt Information</h5>
                    <span class="text-muted small">Verify the record you want to delete.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Are you sure you want to delete this goods receipt?</strong>
                    <div class="small mt-1">This action cannot be undone. Please verify the information below before continuing.</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Goods Receipt Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Goods Receipt ID</label>
                        <div class="detail-value">@Model.GoodsReceiptId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Receipt Number</label>
                        <div class="detail-value">@Model.ReceiptNumber</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Order</label>
                        <div class="detail-value">@(Model.PurchaseOrders.FirstOrDefault(x => x.Value == Model.PurchaseOrderId.ToString())?.Text ?? ("#" + Model.PurchaseOrderId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Warehouse</label>
                        <div class="detail-value">@(Model.Warehouses.FirstOrDefault(x => x.Value == Model.WarehouseId.ToString())?.Text ?? ("#" + Model.WarehouseId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Receipt Date</label>
                        <div class="detail-value">@Model.ReceiptDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value"><span class="status-badge status-pill" data-status="@Model.Status.ToLowerInvariant()">@Model.Status</span></div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="GoodsReceipt" asp-action="DeleteConfirmed" method="post" id="deleteGoodsReceiptForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.GoodsReceiptId" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="GoodsReceipt" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-danger px-4" id="deleteGoodsReceiptBtn"><i class="bi bi-trash3 me-2"></i>Delete Goods Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/GoodsReceipt/Delete.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/GoodsReceipt/Delete.js" asp-append-version="true"></script>
}
