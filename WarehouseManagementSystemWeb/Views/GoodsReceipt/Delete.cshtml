
@model WarehouseManagementSystemWeb.Application.ViewModels.GoodsReceipt.GoodsReceiptUpdateViewModel

@{
    ViewData["Title"] = "Delete Goods Receipt";

    var grandTotal = Model.Details?.Sum(x => x.TotalAmount) ?? 0;
    var totalQuantity = Model.Details?.Sum(x => x.QuantityReceived) ?? 0;
}

<div class="container-fluid px-4 py-4 grn-delete-page">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Delete Goods Receipt
            </h3>

            <p class="text-muted mb-0">
                Review GRN header and product details before deletion.
            </p>
        </div>

        <a asp-controller="GoodsReceipt"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Back
        </a>

    </div>

    <!-- WARNING -->
    <div class="alert grn-delete-warning mb-4">

        <div class="d-flex align-items-center gap-3">

            <i class="bi bi-exclamation-triangle-fill fs-3"></i>

            <div>
                <h6 class="fw-bold mb-1">
                    Delete Confirmation
                </h6>

                <p class="mb-0">
                    You are about to delete this Goods Receipt Note.
                    Please review all information carefully.
                </p>
            </div>

        </div>

    </div>

    <!-- GRN HEADER -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="grn-delete-section-icon">
                    <i class="bi bi-info-circle"></i>
                </div>

                <div>
                    <h5 class="fw-semibold mb-0">
                        Goods Receipt Information
                    </h5>

                    <small class="text-muted">
                        GRN header information
                    </small>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label">
                        Goods Receipt Number
                    </label>

                    <div class="form-control readonly-field fw-semibold">
                        @Model.GoodsReceiptNumber
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Purchase Order Number
                    </label>

                    <div class="form-control readonly-field">
                        @Model.PurchaseOrderNumber
                    </div>
                </div>

                @* <div class="col-md-6">
                    <label class="form-label">
                        Supplier
                    </label>

                 <div class="form-control readonly-field">
                        @Model.SupplierName
                    </div>
                </div> *@

                <div class="col-md-6">
                    <label class="form-label">
                        Warehouse
                    </label>

                    <div class="form-control readonly-field">
                        @Model.WarehouseName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Received By
                    </label>

                    <div class="form-control readonly-field">
                        @Model.ReceivedByEmployeeName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Receipt Date
                    </label>

                    <div class="form-control readonly-field">
                        @Model.ReceiptDate.ToString("dd-MMM-yyyy")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Supplier Invoice Number
                    </label>

                    <div class="form-control readonly-field">
                        @(Model.SupplierInvoiceNumber ?? "N/A")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Status
                    </label>

                    <div class="form-control readonly-field">
                        @Model.Status
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">
                        Remarks
                    </label>

                    <div class="form-control readonly-field remarks-field">
                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "No remarks"
                            : Model.Remarks)
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- GRN PRODUCT DETAILS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="grn-delete-section-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h5 class="fw-semibold mb-0">
                        Goods Receipt Products
                    </h5>

                    <small class="text-muted">
                        Received product details
                    </small>
                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">PRODUCT</th>
                            <th>BATCH NUMBER</th>
                            <th class="text-end">ORDERED QTY</th>
                            <th class="text-end">RECEIVED QTY</th>
                            <th class="text-end">UNIT PRICE</th>
                            <th class="text-end pe-4">TOTAL</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Details != null && Model.Details.Any())
                        {
                            @foreach (var item in Model.Details)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @item.ProductName
                                        </div>
                                    </td>

                                    <td>
                                        <span class="batch-badge">
                                            @(item.BatchNumber ?? "N/A")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        @item.OrderedQuantity.ToString("N3")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @item.QuantityReceived.ToString("N3")
                                    </td>

                                    <td class="text-end">
                                        @item.UnitPrice.ToString("N2")
                                    </td>

                                    <td class="text-end pe-4 fw-semibold">
                                        @item.TotalAmount.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    No product details available.

                                </td>
                            </tr>
                        }

                    </tbody>

                    <tfoot class="table-light">

                        <tr>
                            <td colspan="3" class="ps-4 fw-bold">
                                TOTAL RECEIVED QUANTITY:
                                @totalQuantity.ToString("N3")
                            </td>

                            <td colspan="2" class="text-end fw-bold">
                                GRAND TOTAL
                            </td>

                            <td class="text-end pe-4 fw-bold text-primary">
                                @grandTotal.ToString("N2")
                            </td>
                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>

    <!-- DELETE ACTION -->
    <form asp-controller="GoodsReceipt"
          asp-action="DeleteConfirmed"
          asp-route-id="@Model.GoodsReceiptId"
          method="post"
          id="goodsReceiptDeleteForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.GoodsReceiptId" />

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">

            <a asp-controller="GoodsReceipt"
               asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-x-lg me-2"></i>
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-danger px-4"
                    id="deleteGoodsReceiptBtn">

                <i class="bi bi-trash me-2"></i>
                Delete Goods Receipt

            </button>

        </div>

    </form>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/GoodsReceipt/Delete.css"
          asp-append-version="true" />

}

@section Scripts {

    <script src="~/js/GoodsReceipt/Delete.js"
            asp-append-version="true"></script>

}
