<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Account/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WarehouseManagementSystemWeb.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom shadow-sm wms-navbar">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold"
                   asp-controller="Employee" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-box-seam"></i></span>
                    <span>Warehouse Management</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#wmsMainNav"
                        aria-controls="wmsMainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="wmsMainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-xl-0 ms-xl-3">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-diagram-3 me-1"></i> Organization
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Employee" asp-action="Index">
                                            <i class="bi bi-people me-2"></i> Employees
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Department" asp-action="Index">
                                            <i class="bi bi-building me-2"></i> Departments
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Designation" asp-action="Index">
                                            <i class="bi bi-person-badge me-2"></i> Designations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Warehouse" asp-action="Index">
                                            <i class="bi bi-house-gear me-2"></i> Warehouses
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-boxes me-1"></i> Inventory
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                            <i class="bi bi-box me-2"></i> Products
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ProductCategory" asp-action="Index">
                                            <i class="bi bi-tags me-2"></i> Product Categories
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="UnitOfMeasure" asp-action="Index">
                                            <i class="bi bi-rulers me-2"></i> Units of Measure
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Batch" asp-action="Index">
                                            <i class="bi bi-layers me-2"></i> Batches
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="InventoryStock" asp-action="Index">
                                            <i class="bi bi-clipboard-data me-2"></i> Inventory Stock
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-cart me-1"></i> Purchasing
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Supplier" asp-action="Index">
                                            <i class="bi bi-truck me-2"></i> Suppliers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PurchaseOrder" asp-action="Index">
                                            <i class="bi bi-cart-plus me-2"></i> Purchase Orders
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="PurchaseOrderDetail" asp-action="Index">
                                            <i class="bi bi-list-check me-2"></i> Purchase Order Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="GoodsReceipt" asp-action="Index">
                                            <i class="bi bi-box-arrow-in-down me-2"></i> Goods Receipts
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="GoodsReceiptDetail" asp-action="Index">
                                            <i class="bi bi-card-checklist me-2"></i> Goods Receipt Details
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-receipt me-1"></i> Sales
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Index">
                                            <i class="bi bi-person-lines-fill me-2"></i> Customers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Salesman" asp-action="Index">
                                            <i class="bi bi-person-workspace me-2"></i> Salesmen
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SalesOrder" asp-action="Index">
                                            <i class="bi bi-receipt me-2"></i> Sales Orders
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SalesOrderDetail" asp-action="Index">
                                            <i class="bi bi-list-ul me-2"></i> Sales Order Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SalesReturn" asp-action="Index">
                                            <i class="bi bi-arrow-counterclockwise me-2"></i> Sales Returns
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="SalesReturnDetail" asp-action="Index">
                                            <i class="bi bi-card-list me-2"></i> Sales Return Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ReturnReason" asp-action="Index">
                                            <i class="bi bi-arrow-return-left me-2"></i> Return Reasons
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-truck me-1"></i> Logistics
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="VehicleType" asp-action="Index">
                                            <i class="bi bi-bus-front me-2"></i> Vehicle Types
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Vehicle" asp-action="Index">
                                            <i class="bi bi-truck-front me-2"></i> Vehicles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="VehicleAssignment" asp-action="Index">
                                            <i class="bi bi-person-check me-2"></i> Vehicle Assignments
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Dispatch" asp-action="Index">
                                            <i class="bi bi-send me-2"></i> Dispatches
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="DispatchDetail" asp-action="Index">
                                            <i class="bi bi-list-task me-2"></i> Dispatch Details
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-arrow-left-right me-1"></i> Stock Control
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="StockMovement" asp-action="Index">
                                            <i class="bi bi-arrow-left-right me-2"></i> Stock Movements
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StockAdjustment" asp-action="Index">
                                            <i class="bi bi-sliders me-2"></i> Stock Adjustments
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StockAdjustmentDetail" asp-action="Index">
                                            <i class="bi bi-clipboard-check me-2"></i> Stock Adjustment Details
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StockTransfer" asp-action="Index">
                                            <i class="bi bi-arrow-repeat me-2"></i> Stock Transfers
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StockTransferDetail" asp-action="Index">
                                            <i class="bi bi-clipboard2-data me-2"></i> Stock Transfer Details
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>

                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link user-menu d-flex align-items-center gap-2"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <span class="user-avatar">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <span class="d-none d-xl-inline">
                                        <span class="d-block user-name">@User.Identity.Name</span>
                                        <span class="d-block user-role">
                                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")
                                        </span>
                                    </span>
                                    <i class="bi bi-chevron-down small"></i>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm account-menu">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-semibold">@User.Identity.Name</div>
                                        <div class="text-muted small">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-vcard me-2"></i> My Profile & Devices
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2"></i> Change Password
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                                <i class="bi bi-person-plus me-2"></i> Register User
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="px-2 pb-2">
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 js-logout">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4">
            &copy; 2026 - Warehouse Management System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Alert/showSuccessToast.js" asp-append-version="true"></script>
    <script src="~/js/Account/Layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
