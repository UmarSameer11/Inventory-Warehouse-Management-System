@model WarehouseManagementSystemWeb.Application.ViewModels.StockTransferDetail.StockTransferDetailCreateViewModel

@{
    ViewData["Title"] = "Create Stock Transfer Detail";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Create Stock Transfer Detail</h3>
            <p class="text-muted mb-0">Add a new stock transfer detail to the system.</p>
        </div>
        <a asp-controller="StockTransferDetail" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="create-icon"><i class="bi bi-clipboard2-data"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Stock Transfer Detail Information</h5>
                    <span class="text-muted small">Enter the information for the new stock transfer detail.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-controller="StockTransferDetail" asp-action="Create" method="post" id="stockTransferDetailCreateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-section">
                    <div class="section-heading mb-4">
                        <h6 class="fw-bold mb-1">Line Item Details</h6>
                        <p class="text-muted small mb-0">Fields marked with <span class="text-danger">*</span> are required.</p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="StockTransferId" class="form-label fw-semibold">Stock Transfer <span class="text-danger">*</span></label>
                            <select asp-for="StockTransferId" asp-items="Model.StockTransfers" class="form-select">
                                <option value="">-- Select Stock Transfer --</option>
                            </select>
                            <span asp-validation-for="StockTransferId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ProductId" class="form-label fw-semibold">Product <span class="text-danger">*</span></label>
                            <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                                <option value="">-- Select Product --</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BatchId" class="form-label fw-semibold">Batch</label>
                            <select asp-for="BatchId" asp-items="Model.Batches" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="BatchId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-123"></i></span>
                                <input asp-for="Quantity" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="StockTransferDetail" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary px-4" id="createStockTransferDetailBtn"><i class="bi bi-check-lg me-2"></i>Create Stock Transfer Detail</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/StockTransferDetail/Create.css" asp-append-version="true" /> }
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/StockTransferDetail/Create.js" asp-append-version="true"></script>
}
