@model WarehouseManagementSystemWeb.Application.ViewModels.StockTransferDetail.StockTransferDetailUpdateViewModel

@{
    ViewData["Title"] = "Delete Stock Transfer Detail";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Delete Stock Transfer Detail</h3>
            <p class="text-muted mb-0">Review the information before permanently deleting this record.</p>
        </div>
        <a asp-controller="StockTransferDetail" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="delete-icon"><i class="bi bi-clipboard2-data"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Stock Transfer Detail Information</h5>
                    <span class="text-muted small">Verify the record you want to delete.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Are you sure you want to delete this stock transfer detail?</strong>
                    <div class="small mt-1">This action cannot be undone. Please verify the information below before continuing.</div>
                </div>
            </div>

            <div class="form-section mt-4">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Line Item Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Stock Transfer Detail ID</label>
                        <div class="detail-value">@Model.StockTransferDetailId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Stock Transfer</label>
                        <div class="detail-value">@(Model.StockTransfers.FirstOrDefault(x => x.Value == Model.StockTransferId.ToString())?.Text ?? ("#" + Model.StockTransferId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product</label>
                        <div class="detail-value">@(Model.Products.FirstOrDefault(x => x.Value == Model.ProductId.ToString())?.Text ?? ("#" + Model.ProductId))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Batch</label>
                        <div class="detail-value">@(Model.Batches.FirstOrDefault(x => x.Value == Model.BatchId.ToString())?.Text ?? (Model.BatchId.HasValue ? "#" + Model.BatchId : "Not provided"))</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Quantity</label>
                        <div class="detail-value">@Model.Quantity.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <form asp-controller="StockTransferDetail" asp-action="DeleteConfirmed" method="post" id="deleteStockTransferDetailForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.StockTransferDetailId" />
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a asp-controller="StockTransferDetail" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-x-lg me-2"></i>Cancel</a>
                    <button type="submit" class="btn btn-danger px-4" id="deleteStockTransferDetailBtn"><i class="bi bi-trash3 me-2"></i>Delete Stock Transfer Detail</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/StockTransferDetail/Delete.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/StockTransferDetail/Delete.js" asp-append-version="true"></script>
}
