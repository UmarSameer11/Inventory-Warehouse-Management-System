@model WarehouseManagementSystemWeb.Application.ViewModels.ProductCategory.ProductCategoryUpdateViewModel

@{
    ViewData["Title"] = "Product Category Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Product Category Details</h3>
            <p class="text-muted mb-0">View complete product category information.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ProductCategory" asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-controller="ProductCategory" asp-action="Update" asp-route-id="@Model.ProductCategoryId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="detail-icon"><i class="bi bi-tags"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Product Category Information</h5>
                    <span class="text-muted small">Complete information and current status.</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="form-section">
                <div class="section-heading mb-4">
                    <h6 class="fw-bold mb-1">Product Category Details</h6>
                    <p class="text-muted small mb-0">Basic information about this record.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Product Category ID</label>
                        <div class="detail-value">@Model.ProductCategoryId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Category Name</label>
                        <div class="detail-value">@Model.CategoryName</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Description</label>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.Description) ? "Not provided" : Model.Description)</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Status</label>
                        <div class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a asp-controller="ProductCategory" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <a asp-controller="ProductCategory" asp-action="Update" asp-route-id="@Model.ProductCategoryId" class="btn btn-primary px-4"><i class="bi bi-pencil-square me-2"></i>Edit Product Category</a>
            </div>
        </div>
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/ProductCategory/Detail.css" asp-append-version="true" /> }